@model FitnessCenter.Models.Appointment
@{
    ViewData["Title"] = "Randevu Al";
    var selectedTrainerId = ViewBag.SelectedTrainerId as int?;
    var selectedFitnessCenterId = ViewBag.SelectedFitnessCenterId as int?;
    var trainer = ViewBag.Trainer as FitnessCenter.Models.Trainer;
    var services = ViewBag.Services as List<FitnessCenter.Models.Service>;
}

<div class="container my-5">
    @if (trainer != null)
    {
        <!-- Seçilen Antrenör Bilgileri -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    <i class="bi bi-person-circle me-2"></i>
                    @trainer.FirstName @trainer.LastName ile Randevu Al
                </h5>
            </div>
            <div class="card-body">
                <p class="mb-1"><strong>Uzmanlık Alanları:</strong> @trainer.Specializations</p>
                <p class="mb-1"><strong>Salon:</strong> @trainer.FitnessCenter?.Name</p>
                @if (!string.IsNullOrEmpty(trainer.Description))
                {
                    <p class="mb-0"><strong>Hakkında:</strong> @trainer.Description</p>
                }
            </div>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <form asp-action="Create" method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger border border-danger p-3 rounded mb-3" style="background-color: #f8d7da;"></div>

        <input type="hidden" asp-for="TrainerId" value="@selectedTrainerId" />

        <!-- Hizmet Seçimi -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0">Hizmet Seçin</h6>
            </div>
            <div class="card-body">
                @if (services != null && services.Any())
                {
                    <div class="row">
                        @foreach (var service in services.OrderBy(s => s.ServiceType))
                        {
                            <div class="col-md-6 mb-3">
                                <div class="form-check">
                                    <input class="form-check-input service-radio" type="radio" asp-for="ServiceId"
                                           value="@service.Id" id="service_@service.Id" required>
                                    <label class="form-check-label" for="service_@service.Id">
                                        <strong>@service.Name</strong><br>
                                        <small class="text-muted">
                                            Süre: @service.DurationMinutes dk | Ücret: ₺@service.Price.ToString("N0")
                                        </small>
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <p class="text-muted">Bu antrenörün şu anda aktif bir hizmeti bulunmuyor.</p>
                }
            </div>
        </div>

        <!-- Tarih ve Saat Seçimi -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0">Tarih ve Saat Seçin</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="AppointmentDate" class="form-label">Tarih</label>
                        <input asp-for="AppointmentDate" class="form-control" type="date"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")"
                               onchange="updateAvailableTimes()" required />
                        <span asp-validation-for="AppointmentDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="AppointmentTime" class="form-label">Saat</label>
                        <select asp-for="AppointmentTime" class="form-select" id="timeSelect" required disabled>
                            <option value="">Önce tarih seçin</option>
                        </select>
                        <span asp-validation-for="AppointmentTime" class="text-danger"></span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Kart Bilgileri -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0">Kart Bilgileri</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CardHolderName" class="form-label">Kart Sahibi Adı</label>
                        <input asp-for="CardHolderName" class="form-control" placeholder="Ad Soyad" required />
                        <span asp-validation-for="CardHolderName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CardNumber" class="form-label">Kart Numarası</label>
                        <input asp-for="CardNumber" class="form-control" placeholder="1234 5678 9012 3456" maxlength="16" required />
                        <span asp-validation-for="CardNumber" class="text-danger"></span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CardExpiryDate" class="form-label">Son Kullanma Tarihi</label>
                        <input asp-for="CardExpiryDate" class="form-control" placeholder="12/25" maxlength="5" required />
                        <span asp-validation-for="CardExpiryDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="CardCVV" class="form-label">CVV Kodu</label>
                        <input asp-for="CardCVV" class="form-control" placeholder="123" maxlength="4" required />
                        <span asp-validation-for="CardCVV" class="text-danger"></span>
                    </div>
                </div>
                <div class="alert alert-info">
                    <i class="bi bi-info-circle me-2"></i>
                    <small>Kart bilgileriniz güvenli bir şekilde saklanmaktadır ve sadece randevu onay işlemi için kullanılacaktır.</small>
                </div>
            </div>
        </div>

        <!-- Notlar -->
        <div class="card mb-4">
            <div class="card-header">
                <h6 class="mb-0">Ek Notlar (İsteğe bağlı)</h6>
            </div>
            <div class="card-body">
                <textarea asp-for="Notes" class="form-control" rows="3"
                          placeholder="Özel istekleriniz veya notlarınız..."></textarea>
                <span asp-validation-for="Notes" class="text-danger"></span>
            </div>
        </div>

        <!-- Butonlar -->
        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success btn-lg">
                <i class="bi bi-calendar-check me-2"></i>Randevu Al
            </button>
            <a asp-controller="Trainers" asp-action="List" class="btn btn-outline-secondary btn-lg">
                <i class="bi bi-arrow-left me-2"></i>Geri Dön
            </a>
        </div>
    </form>
</div>

@section Scripts {
    <script>
        let selectedTrainerId = @selectedTrainerId;

        function updateAvailableTimes() {
            const dateInput = document.getElementById('AppointmentDate');
            const timeSelect = document.getElementById('timeSelect');
            const selectedDate = dateInput.value;

            if (!selectedDate || !selectedTrainerId) {
                timeSelect.innerHTML = '<option value="">Önce tarih seçin</option>';
                timeSelect.disabled = true;
                return;
            }

            // AJAX ile müsait saatleri getir
            fetch(`/Appointments/GetAvailableTimeSlots?trainerId=${selectedTrainerId}&date=${selectedDate}`)
                .then(response => response.json())
                .then(data => {
                    timeSelect.innerHTML = '<option value="">Saat seçin</option>';

                    if (data.length === 0) {
                        timeSelect.innerHTML = '<option value="">Bu tarihte müsait saat yok</option>';
                        timeSelect.disabled = true;
                        return;
                    }

                    data.forEach(slot => {
                        const option = document.createElement('option');
                        option.value = slot.value;
                        option.textContent = slot.time;
                        
                        // Dolu saatleri devre dışı bırak ve kırmızı göster
                        if (slot.isBooked === true || slot.isBooked === 'true') {
                            option.disabled = true;
                            option.style.color = '#dc3545';
                            option.style.fontWeight = 'bold';
                            option.style.backgroundColor = '#f8d7da';
                        }
                        
                        timeSelect.appendChild(option);
                    });

                    timeSelect.disabled = false;
                })
                .catch(error => {
                    console.error('Error:', error);
                    timeSelect.innerHTML = '<option value="">Hata oluştu</option>';
                    timeSelect.disabled = true;
                });
        }

        // Sayfa yüklendiğinde eğer tarih seçili ise saatleri güncelle
        document.addEventListener('DOMContentLoaded', function() {
            const dateInput = document.getElementById('AppointmentDate');
            if (dateInput.value) {
                updateAvailableTimes();
            }
        });
    </script>
}
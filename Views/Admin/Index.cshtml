@{
    ViewData["Title"] = "Yönetim Paneli";
    var stats = ViewBag.Stats as dynamic;
}

<!-- Professional Admin Dashboard -->
<div class="admin-dashboard">
    <!-- Header Section -->
    <div class="admin-header">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="admin-welcome">
                        <h1 class="admin-title">
                            <i class="bi bi-shield-check-fill me-3"></i>
                            YÖNETİM PANELİ
                        </h1>
                        <p class="admin-subtitle">KADIR Fitness yönetim sistemi</p>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <div class="admin-meta">
                        <div class="current-time" id="current-time"></div>
                        <div class="current-date" id="current-date"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="admin-content">
        <div class="container-fluid">
            <!-- Statistics Cards -->
            <div class="row mb-5">
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="stats-card">
                        <div class="stats-icon">
                            <i class="bi bi-calendar-check-fill"></i>
                        </div>
                        <div class="stats-content">
                            <div class="stats-number">@stats?.Appointments</div>
                            <div class="stats-label">TOPLAM RANDEVU</div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="stats-card">
                        <div class="stats-icon">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <div class="stats-content">
                            <div class="stats-number">@stats?.Trainers</div>
                            <div class="stats-label">AKTİF ANTRENÖR</div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="stats-card">
                        <div class="stats-icon">
                            <i class="bi bi-tools-fill"></i>
                        </div>
                        <div class="stats-content">
                            <div class="stats-number">@stats?.Services</div>
                            <div class="stats-label">AKTİF HİZMET</div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-3 col-md-6 mb-4">
                    <div class="stats-card">
                        <div class="stats-icon">
                            <i class="bi bi-people-fill"></i>
                        </div>
                        <div class="stats-content">
                            <div class="stats-number">@stats?.Members</div>
                            <div class="stats-label">KAYITLI ÜYE</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- API Test Section -->
            <div class="row mb-5">
                <div class="col-12">
                    <div class="api-test-card">
                        <div class="api-test-header">
                            <div class="api-test-icon">
                                <i class="bi bi-robot"></i>
                            </div>
                            <div class="api-test-title">
                                <h3>🔧 Gemini API Test</h3>
                                <p>API bağlantısını test edin ve durumu kontrol edin</p>
                            </div>
                        </div>
                        <div class="api-test-content">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <button id="apiTestBtn" class="btn btn-primary btn-lg w-100">
                                        <i class="bi bi-play-circle me-2"></i>API Bağlantısını Test Et
                                    </button>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <button id="apiKeyTestBtn" class="btn btn-info btn-lg w-100">
                                        <i class="bi bi-key me-2"></i>API Anahtarını Kontrol Et
                                    </button>
                                </div>
                            </div>
                            <div id="apiTestResult" class="mt-3"></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Management Modules -->
            <div class="row">
                <div class="col-12">
                    <h2 class="section-title">YÖNETİM MODÜLLERİ</h2>
                </div>
            </div>

            <div class="row g-4">
                <!-- Randevu Yönetimi -->
                <div class="col-xl-3 col-lg-6 mb-4">
                    <div class="module-card">
                        <div class="module-header">
                            <div class="module-icon">
                                <i class="bi bi-calendar-check-fill"></i>
                            </div>
                            <div class="module-title">RANDEVU YÖNETİMİ</div>
                        </div>
                        <div class="module-content">
                            <p class="module-description">Tüm randevuları görüntüleyin, onaylayın,</p>
                            @if (stats?.PendingAppointments > 0)
                            {
                                <div class="module-stats">
                                    <span class="badge bg-warning">@stats?.PendingAppointments bekleyen</span>
                                </div>
                            }
                        </div>
                        <div class="module-footer">
                            <a asp-controller="Admin" asp-action="Appointments" class="btn btn-primary w-100">
                                <i class="bi bi-arrow-right-circle me-2"></i>Yönet
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Antrenör Yönetimi -->
                <div class="col-xl-3 col-lg-6 mb-4">
                    <div class="module-card">
                        <div class="module-header">
                            <div class="module-icon">
                                <i class="bi bi-person-badge-fill"></i>
                            </div>
                            <div class="module-title">ANTRENÖR YÖNETİMİ</div>
                        </div>
                        <div class="module-content">
                            <p class="module-description">Antrenörleri ekleyin, düzenleyin, aktif/pasif</p>
                        </div>
                        <div class="module-footer">
                            <a asp-controller="Admin" asp-action="Trainers" class="btn btn-primary w-100">
                                <i class="bi bi-arrow-right-circle me-2"></i>Yönet
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Hizmet Yönetimi -->
                <div class="col-xl-3 col-lg-6 mb-4">
                    <div class="module-card">
                        <div class="module-header">
                            <div class="module-icon">
                                <i class="bi bi-tools-fill"></i>
                            </div>
                            <div class="module-title">HİZMET YÖNETİMİ</div>
                        </div>
                        <div class="module-content">
                            <p class="module-description">Hizmetleri ekleyin, güncelleyin, fiyatlandırın</p>
                        </div>
                        <div class="module-footer">
                            <a asp-controller="Admin" asp-action="Services" class="btn btn-primary w-100">
                                <i class="bi bi-arrow-right-circle me-2"></i>Yönet
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Üyelik Yönetimi -->
                <div class="col-xl-3 col-lg-6 mb-4">
                    <div class="module-card">
                        <div class="module-header">
                            <div class="module-icon">
                                <i class="bi bi-card-checklist-fill"></i>
                            </div>
                            <div class="module-title">ÜYELİK YÖNETİMİ</div>
                        </div>
                        <div class="module-content">
                            <p class="module-description">Üyelik paketlerini yönetin, üyeleri</p>
                        </div>
                        <div class="module-footer">
                            <a asp-controller="Admin" asp-action="Memberships" class="btn btn-primary w-100">
                                <i class="bi bi-arrow-right-circle me-2"></i>Yönet
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    /* Admin Dashboard Styles - Professional Black/Gray Theme */
    .admin-dashboard {
        background: #1a1a1a;
        min-height: calc(100vh - 76px);
        color: #ffffff;
    }

    /* Header Section */
    .admin-header {
        background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
        padding: 2rem 0;
        border-bottom: 1px solid #404040;
    }

    .admin-welcome .admin-title {
        font-size: 2.5rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.5rem;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .admin-welcome .admin-subtitle {
        font-size: 1.1rem;
        color: #b0b0b0;
        margin-bottom: 0;
    }

    .admin-meta {
        text-align: right;
    }

    .current-time {
        font-size: 1.8rem;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 0.25rem;
    }

    .current-date {
        font-size: 0.9rem;
        color: #888888;
    }

    /* Statistics Cards */
    .stats-card {
        background: linear-gradient(135deg, #2d2d2d 0%, #1f1f1f 100%);
        border: 1px solid #404040;
        border-radius: 12px;
        padding: 1.5rem;
        display: flex;
        align-items: center;
        transition: all 0.3s ease;
        height: 100%;
    }

    .stats-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.3);
        border-color: #555555;
    }

    .stats-icon {
        background: linear-gradient(135deg, #4a4a4a 0%, #333333 100%);
        border-radius: 12px;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1rem;
        color: #ffffff;
        font-size: 1.5rem;
    }

    .stats-content .stats-number {
        font-size: 2.2rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 0.25rem;
    }

    .stats-content .stats-label {
        font-size: 0.9rem;
        color: #b0b0b0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Section Title */
    .section-title {
        font-size: 1.4rem;
        font-weight: 600;
        color: #ffffff;
        margin-bottom: 2rem;
        padding-bottom: 0.5rem;
        border-bottom: 2px solid #404040;
    }

    /* Module Cards */
    .module-card {
        background: linear-gradient(135deg, #2a2a2a 0%, #1e1e1e 100%);
        border: 1px solid #404040;
        border-radius: 15px;
        overflow: hidden;
        transition: all 0.3s ease;
        height: 100%;
        display: flex;
        flex-direction: column;
    }

    .module-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 35px rgba(0,0,0,0.4);
        border-color: #555555;
    }

    .module-header {
        background: linear-gradient(135deg, #333333 0%, #262626 100%);
        padding: 1.5rem;
        text-align: center;
        border-bottom: 1px solid #404040;
    }

    .module-icon {
        background: linear-gradient(135deg, #4a4a4a 0%, #333333 100%);
        border-radius: 50%;
        width: 70px;
        height: 70px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 1rem auto;
        color: #ffffff;
        font-size: 1.8rem;
        box-shadow: 0 4px 15px rgba(0,0,0,0.3);
    }

    .module-title {
        font-size: 1.1rem;
        font-weight: 600;
        color: #ffffff;
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .module-content {
        padding: 1.5rem;
        flex: 1;
    }

    .module-description {
        color: #b0b0b0;
        font-size: 0.9rem;
        line-height: 1.5;
        margin-bottom: 1rem;
    }

    .module-stats .badge {
        background: #404040 !important;
        color: #ffffff;
        font-size: 0.75rem;
    }

    .module-footer {
        padding: 1.5rem;
        background: linear-gradient(135deg, #262626 0%, #1a1a1a 100%);
        border-top: 1px solid #404040;
    }

    .module-footer .btn {
        background: linear-gradient(135deg, #007bff 0%, #0056b3 100%);
        border: none;
        padding: 0.75rem 1.5rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        transition: all 0.3s ease;
    }

    .module-footer .btn:hover {
        background: linear-gradient(135deg, #0056b3 0%, #004085 100%);
        transform: translateY(-1px);
        box-shadow: 0 4px 15px rgba(0,123,255,0.3);
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .admin-welcome .admin-title {
            font-size: 2rem;
        }

        .stats-card {
            padding: 1rem;
        }

        .stats-icon {
            width: 50px;
            height: 50px;
            font-size: 1.2rem;
        }

        .stats-content .stats-number {
            font-size: 1.8rem;
        }

        .module-icon {
            width: 60px;
            height: 60px;
            font-size: 1.5rem;
        }
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
        width: 8px;
    }

    ::-webkit-scrollbar-track {
        background: #1a1a1a;
    }

    ::-webkit-scrollbar-thumb {
        background: #404040;
        border-radius: 4px;
    }

    ::-webkit-scrollbar-thumb:hover {
        background: #555555;
    }

    /* API Test Card Styles */
    .api-test-card {
        background: linear-gradient(135deg, #2a2a2a 0%, #1e1e1e 100%);
        border: 1px solid #404040;
        border-radius: 15px;
        padding: 2rem;
        margin-bottom: 2rem;
    }

    .api-test-header {
        display: flex;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #404040;
    }

    .api-test-icon {
        background: linear-gradient(135deg, #4a4a4a 0%, #333333 100%);
        border-radius: 50%;
        width: 60px;
        height: 60px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-right: 1.5rem;
        color: #ffffff;
        font-size: 1.8rem;
    }

    .api-test-title h3 {
        color: #ffffff;
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 0.5rem;
    }

    .api-test-title p {
        color: #b0b0b0;
        margin: 0;
        font-size: 0.9rem;
    }

    .api-test-content .btn {
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .api-test-content .alert {
        border: 1px solid #404040;
        background: #1e1e1e;
        color: #ffffff;
    }

    .api-test-content .alert-success {
        background: #1e3a1e;
        border-color: #2d5a2d;
    }

    .api-test-content .alert-danger {
        background: #3a1e1e;
        border-color: #5a2d2d;
    }

    .api-test-content .alert-info {
        background: #1e2a3a;
        border-color: #2d3a5a;
    }
</style>

<script>
    // Real-time clock
    function updateTime() {
        const now = new Date();
        const timeElement = document.getElementById('current-time');
        const dateElement = document.getElementById('current-date');

        if (timeElement && dateElement) {
            timeElement.textContent = now.toLocaleTimeString('tr-TR', {
                hour: '2-digit',
                minute: '2-digit',
                second: '2-digit'
            });

            dateElement.textContent = now.toLocaleDateString('tr-TR', {
                weekday: 'long',
                year: 'numeric',
                month: 'long',
                day: 'numeric'
            });
        }
    }

    // Update time every second
    setInterval(updateTime, 1000);
    updateTime(); // Initial call

    // API Test Functions - Hem jQuery hem vanilla JS desteği
    function initApiTestButtons() {
        console.log('API test butonları başlatılıyor...');
        
        var apiTestBtn = document.getElementById('apiTestBtn');
        var apiKeyTestBtn = document.getElementById('apiKeyTestBtn');
        var apiTestResult = document.getElementById('apiTestResult');
        
        console.log('API Test Butonu:', apiTestBtn ? 'Bulundu' : 'Bulunamadı');
        console.log('API Key Test Butonu:', apiKeyTestBtn ? 'Bulundu' : 'Bulunamadı');
        console.log('API Test Result:', apiTestResult ? 'Bulundu' : 'Bulunamadı');
        
        if (!apiTestResult) {
            console.error('apiTestResult elementi bulunamadı!');
            return;
        }
        
        // API Test Butonu - Vanilla JS ile
        if (apiTestBtn) {
            apiTestBtn.addEventListener('click', function() {
                console.log('API Test butonu tıklandı (vanilla JS)');
                var btn = this;
                var result = apiTestResult;
                
                btn.disabled = true;
                result.innerHTML = '<div class="alert alert-info">⏳ API test ediliyor...</div>';
                
                // Önce GET test
                fetch('/api/Ai/Test')
                    .then(response => response.json())
                    .then(data => {
                        console.log('GET test başarılı:', data);
                        result.innerHTML = '<div class="alert alert-success">✓ GET çalışıyor! </div>';
                        
                        // Sonra POST test
                        return fetch('/api/Ai/TestPost', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ test: 'data', number: 123 })
                        });
                    })
                    .then(response => response.json())
                    .then(data => {
                        console.log('POST test başarılı:', data);
                        result.innerHTML = '<div class="alert alert-success">✓✓ GET ve POST çalışıyor! API hazır.<br><small>Response: ' + JSON.stringify(data) + '</small></div>';
                        btn.disabled = false;
                    })
                    .catch(error => {
                        console.error('API test hatası:', error);
                        result.innerHTML = '<div class="alert alert-danger">✗ Hata: ' + error.message + '</div>';
                        btn.disabled = false;
                    });
            });
        }
        
        // API Key Test Butonu - Vanilla JS ile
        if (apiKeyTestBtn) {
            apiKeyTestBtn.addEventListener('click', function() {
                console.log('API Key Test butonu tıklandı (vanilla JS)');
                var btn = this;
                var result = apiTestResult;
                
                btn.disabled = true;
                result.innerHTML = '<div class="alert alert-info">⏳ API anahtarı kontrol ediliyor...</div>';
                
                fetch('/api/Ai/TestApiKey')
                    .then(response => response.json())
                    .then(data => {
                        console.log('API Key test başarılı:', data);
                        result.innerHTML = '<div class="alert alert-success">✓ API Anahtarı: ' + (data.apiKeyPreview || 'Bulunamadı') + '<br>Status: ' + (data.status || 'OK') + '</div>';
                        btn.disabled = false;
                    })
                    .catch(error => {
                        console.error('API Key test hatası:', error);
                        result.innerHTML = '<div class="alert alert-danger">✗ API anahtarı hatası: ' + error.message + '</div>';
                        btn.disabled = false;
                    });
            });
        }
    }
    
    // Sayfa yüklendiğinde çalıştır
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initApiTestButtons);
    } else {
        initApiTestButtons();
    }
    
    // jQuery de varsa onu da kullan
    if (typeof jQuery !== 'undefined') {
        jQuery(document).ready(function($) {
            console.log('jQuery yüklü, ekstra kontrol yapılıyor...');
            initApiTestButtons();
        });
    }
</script>

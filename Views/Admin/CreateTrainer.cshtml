@model FitnessCenter.Models.CreateTrainerViewModel

@{
    ViewData["Title"] = "Yeni Antrenör Ekle";
    var services = ViewBag.Services as IEnumerable<FitnessCenter.Models.Service>;
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-person-plus me-2"></i>Yeni Antrenör Ekle
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="CreateTrainer" method="post">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FirstName" class="form-label">Ad *</label>
                                <input asp-for="FirstName" class="form-control" required />
                                <span asp-validation-for="FirstName" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="LastName" class="form-label">Soyad *</label>
                                <input asp-for="LastName" class="form-control" required />
                                <span asp-validation-for="LastName" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label">E-posta</label>
                            <input asp-for="Email" type="email" class="form-control" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Specializations" class="form-label">Uzmanlık Alanları *</label>
                            <textarea asp-for="Specializations" class="form-control" rows="2"
                                      placeholder="Örn: Güç Antrenmanı, Kas Geliştirme, Kişisel Antrenman" required></textarea>
                            <small class="form-text text-muted">Virgülle ayırarak birden fazla uzmanlık alanı ekleyebilirsiniz.</small>
                            <span asp-validation-for="Specializations" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Antrenör hakkında kısa bir açıklama..."></textarea>
                        </div>

                        <div class="mb-3">
                            <label asp-for="FitnessCenterId" class="form-label">Spor Salonu *</label>
                            <select asp-for="FitnessCenterId" asp-items="ViewBag.FitnessCenters" class="form-select" required>
                                <option value="">Seçiniz...</option>
                            </select>
                            <span asp-validation-for="FitnessCenterId" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="StartTime" class="form-label">Çalışma Başlangıç Saati *</label>
                                <input asp-for="StartTime" class="form-control" type="time" required />
                                <span asp-validation-for="StartTime" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="EndTime" class="form-label">Çalışma Bitiş Saati *</label>
                                <input asp-for="EndTime" class="form-control" type="time" required />
                                <span asp-validation-for="EndTime" class="text-danger"></span>
                            </div>
                        </div>
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle me-2"></i>
                            <strong>Bilgi:</strong> Antrenör çalışma saatleri spor salonu çalışma saatleri (05:00 - 22:00) içinde olmalıdır.
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Verdiği Hizmetler</label>
                            <div class="row">
                                @if (services != null)
                                {
                                    @foreach (var service in services)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox"
                                                       name="SelectedServices" value="@service.Id" id="service-@service.Id"
                                                       checked="@(Model?.SelectedServices?.Contains(service.Id) ?? false)">
                                                <label class="form-check-label" for="service-@service.Id">
                                                    @service.Name
                                                    <small class="text-muted">(@service.ServiceType)</small>
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                            <small class="form-text text-muted">Antrenörün verebileceği hizmetleri seçin.</small>
                        </div>


                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-check-circle me-2"></i>Antrenörü Kaydet
                            </button>
                            <a asp-action="Trainers" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Geri Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

@model IEnumerable<FitnessCenter.Models.Service>

@{
    ViewData["Title"] = "Hizmet Yönetimi";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Hizmet Yönetimi</h1>
        <a asp-action="CreateService" class="btn btn-success">
            <i class="bi bi-plus-circle me-2"></i>Yeni Hizmet Ekle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Hizmet Adı</th>
                            <th>Hizmet Türü</th>
                            <th>Süre</th>
                            <th>Ücret</th>
                            <th>Spor Salonu</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var service in Model)
                        {
                            <tr>
                                <td>
                                    <strong>@service.Name</strong>
                                    @if (!string.IsNullOrEmpty(service.Description))
                                    {
                                        <br><small class="text-muted">@service.Description</small>
                                    }
                                </td>
                                <td>
                                    <span class="badge bg-primary">@service.ServiceType.GetDisplayName()</span>
                                </td>
                                <td>@service.DurationMinutes dakika</td>
                                <td><strong>@service.Price.ToString("C")</strong></td>
                                <td>@service.FitnessCenter?.Name</td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="EditService" asp-route-id="@service.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i> Düzenle
                                        </a>
                                        <form asp-action="DeleteService" asp-route-id="@service.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Bu hizmeti silmek istediğinizden emin misiniz?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Sil
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-list-check text-muted" style="font-size: 3rem;"></i>
                    <h5 class="text-muted mt-3">Henüz hizmet eklenmemiş</h5>
                    <a asp-action="CreateService" class="btn btn-primary mt-3">
                        İlk Hizmeti Ekle
                    </a>
                </div>
            }
        </div>
    </div>
</div>


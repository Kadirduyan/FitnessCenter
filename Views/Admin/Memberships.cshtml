@model IEnumerable<FitnessCenter.Models.Membership>

@{
    ViewData["Title"] = "Üyelik Yönetimi";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Üyelik Yönetimi</h1>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Üye</th>
                            <th>Üyelik Türü</th>
                            <th>Başlangıç Tarihi</th>
                            <th>Bitiş Tarihi</th>
                            <th>Kalan Gün</th>
                            <th>Ücret</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var membership in Model)
                        {
                            <tr>
                                <td>
                                    <div>
                                        <strong>@membership.Member?.FirstName @membership.Member?.LastName</strong><br>
                                        <small class="text-muted">@membership.Member?.Email</small>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-info">@membership.MembershipType.GetDisplayName()</span>
                                </td>
                                <td>@membership.StartDate.ToString("dd.MM.yyyy")</td>
                                <td>@membership.EndDate.ToString("dd.MM.yyyy")</td>
                                <td>
                                    <span class="badge bg-@membership.StatusColor">@membership.DaysRemaining gün</span>
                                </td>
                                <td><strong>@membership.Price.ToString("C")</strong></td>
                                <td>
                                    <span class="badge bg-@membership.StatusColor">@membership.StatusText</span>
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-action="ExtendMembership" asp-route-id="@membership.Id"
                                           class="btn btn-sm btn-outline-success">
                                            <i class="bi bi-calendar-plus"></i> Uzat
                                        </a>
                                        <form asp-action="DeleteMembership" asp-route-id="@membership.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Bu üyeliği silmek istediğinizden emin misiniz?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Sil
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-card-checklist text-muted" style="font-size: 3rem;"></i>
                    <h5 class="text-muted mt-3">Henüz üyelik kaydı bulunmuyor</h5>
                </div>
            }
        </div>
    </div>
</div>


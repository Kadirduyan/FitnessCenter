@model IEnumerable<FitnessCenter.Models.Trainer>

@{
    ViewData["Title"] = "Antrenör Yönetimi";
}

<!-- Admin Page Container - Dark Theme -->
<div class="admin-page">
    <div class="container-fluid py-4">
        <!-- Header Section -->
        <div class="admin-header-section mb-4">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="page-title-section">
                        <div class="page-icon">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>
                        <div class="page-title-content">
                            <h1 class="page-title">ANTRENÖR YÖNETİMİ</h1>
                            <p class="page-subtitle">Antrenörleri görüntüleyin ve yönetin</p>
                        </div>
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <a href="/Admin/Index" class="admin-back-btn">
                        <i class="bi bi-arrow-left me-2"></i>
                        Panele Dön
                    </a>
                    <a asp-action="CreateTrainer" class="admin-add-btn">
                        <i class="bi bi-plus-circle-fill me-2"></i>
                        Yeni Antrenör Ekle
                    </a>
                </div>
            </div>
        </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

        <!-- Trainers Grid -->
        @if (Model.Any())
        {
            <div class="trainers-grid">
                @foreach (var trainer in Model)
                {
                    <div class="trainer-card-modern">
                        <!-- Trainer Card Header -->
                        <div class="trainer-card-header">
                            <div class="trainer-avatar-section">
                                <div class="trainer-avatar">
                                    <span class="avatar-text">@(trainer.FirstName[0])@(trainer.LastName[0])</span>
                                </div>
                                <div class="trainer-status">
                                    @if (trainer.IsActive)
                                    {
                                        <span class="status-indicator active">
                                            <i class="bi bi-circle-fill"></i>
                                            Aktif
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-indicator inactive">
                                            <i class="bi bi-circle-fill"></i>
                                            Pasif
                                        </span>
                                    }
                                </div>
                            </div>
                            <div class="trainer-actions">
                                <a asp-controller="Trainers" asp-action="Details" asp-route-id="@trainer.Id"
                                   class="action-btn view-btn" title="Görüntüle">
                                    <i class="bi bi-eye-fill"></i>
                                </a>
                                <a asp-controller="Trainers" asp-action="Edit" asp-route-id="@trainer.Id"
                                   class="action-btn edit-btn" title="Düzenle">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <form asp-controller="Trainers" asp-action="Delete" asp-route-id="@trainer.Id"
                                      method="post" class="d-inline"
                                      onsubmit="return confirm('Bu antrenörü silmek istediğinizden emin misiniz?');">
                                    <button type="submit" class="action-btn delete-btn" title="Sil">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </div>

                        <!-- Trainer Card Body -->
                        <div class="trainer-card-body">
                            <!-- Trainer Info -->
                            <div class="trainer-info-section">
                                <h3 class="trainer-name">@trainer.FirstName @trainer.LastName</h3>
                                <div class="trainer-email">
                                    <i class="bi bi-envelope-fill"></i>
                                    <span>@trainer.Email</span>
                                </div>
                            </div>

                            <!-- Specializations -->
                            <div class="trainer-specializations">
                                <div class="section-header">
                                    <i class="bi bi-award-fill"></i>
                                    <span>Uzmanlık Alanları</span>
                                </div>
                                <div class="specialization-tags">
                                    <span class="specialization-tag">@trainer.Specializations</span>
                                </div>
                            </div>

                            <!-- Gym Info -->
                            <div class="trainer-gym">
                                <div class="section-header">
                                    <i class="bi bi-geo-alt-fill"></i>
                                    <span>Spor Salonu</span>
                                </div>
                                <div class="gym-info">
                                    <span class="gym-name">@trainer.FitnessCenter?.Name</span>
                                    <span class="gym-address">@trainer.FitnessCenter?.Address</span>
                                </div>
                            </div>

                            <!-- Services -->
                            @if (trainer.Services.Any())
                            {
                                <div class="trainer-services">
                                    <div class="section-header">
                                        <i class="bi bi-tools"></i>
                                        <span>Hizmetler</span>
                                    </div>
                                    <div class="service-tags">
                                        @foreach (var service in trainer.Services)
                                        {
                                            <span class="service-tag">
                                                <i class="bi bi-check-circle-fill"></i>
                                                @service.Name
                                            </span>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <!-- Empty State -->
            <div class="empty-state-section">
                <div class="empty-state-content">
                    <div class="empty-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>
                    <h3 class="empty-title">Henüz Antrenör Eklenmemiş</h3>
                    <p class="empty-description">Sistemde kayıtlı antrenör bulunmuyor. İlk antrenörü ekleyerek başlayabilirsiniz.</p>
                    <a asp-action="CreateTrainer" class="admin-add-btn">
                        <i class="bi bi-plus-circle-fill me-2"></i>
                        İlk Antrenörü Ekle
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<!-- Admin Dark Theme Styles -->
<style>
    /* Admin Page Base Styles */
    .admin-page {
        background: linear-gradient(135deg, #1a1a1a 0%, #2d2d2d 100%);
        min-height: 100vh;
        color: #e0e0e0;
    }

    /* Header Section */
    .admin-header-section {
        background: linear-gradient(135deg, #2a2a2a 0%, #3d3d3d 100%);
        border-radius: 15px;
        padding: 25px;
        margin-bottom: 30px;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        border: 1px solid #404040;
    }

    .page-title-section {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .page-icon {
        width: 70px;
        height: 70px;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2rem;
        color: white;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

    .page-title {
        font-size: 2.2rem;
        font-weight: 700;
        margin: 0;
        color: #ffffff;
        text-shadow: 0 2px 4px rgba(0,0,0,0.3);
        letter-spacing: 1px;
    }

    .page-subtitle {
        margin: 5px 0 0 0;
        color: #b0b0b0;
        font-size: 1rem;
    }

    .admin-back-btn {
        background: linear-gradient(135deg, #4a4a4a 0%, #5a5a5a 100%);
        color: #ffffff;
        padding: 12px 24px;
        border-radius: 10px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        border: 1px solid #606060;
        margin-right: 15px;
    }

    .admin-back-btn:hover {
        background: linear-gradient(135deg, #5a5a5a 0%, #6a6a6a 100%);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(0,0,0,0.4);
        color: #ffffff;
    }

    .admin-add-btn {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: #ffffff;
        padding: 12px 24px;
        border-radius: 10px;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        border: 1px solid #28a745;
    }

    .admin-add-btn:hover {
        background: linear-gradient(135deg, #218838, #1aa085);
        transform: translateY(-2px);
        box-shadow: 0 6px 20px rgba(40, 167, 69, 0.3);
        color: #ffffff;
    }

    /* Trainers Grid */
    .trainers-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(400px, 1fr));
        gap: 25px;
    }

    /* Trainer Cards */
    .trainer-card-modern {
        background: linear-gradient(135deg, #2a2a2a 0%, #3d3d3d 100%);
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        border: 1px solid #404040;
        transition: all 0.3s ease;
        position: relative;
    }

    .trainer-card-modern:hover {
        transform: translateY(-5px);
        box-shadow: 0 15px 40px rgba(0,0,0,0.4);
        border-color: #505050;
    }

    .trainer-card-modern::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 4px;
        background: linear-gradient(90deg, #667eea, #764ba2);
    }

    /* Card Header */
    .trainer-card-header {
        background: linear-gradient(135deg, #1e1e1e 0%, #2a2a2a 100%);
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #404040;
    }

    .trainer-avatar-section {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .trainer-avatar {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        background: linear-gradient(135deg, #667eea, #764ba2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
        font-weight: 700;
        color: white;
        box-shadow: 0 4px 15px rgba(102, 126, 234, 0.3);
    }

    .trainer-status {
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .status-indicator {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .status-indicator.active {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
    }

    .status-indicator.inactive {
        background: linear-gradient(135deg, #6c757d, #495057);
        color: white;
    }

    .status-indicator i {
        font-size: 0.6rem;
    }

    .trainer-actions {
        display: flex;
        gap: 8px;
    }

    .action-btn {
        width: 40px;
        height: 40px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: all 0.3s ease;
        font-size: 1.1rem;
    }

    .view-btn {
        background: linear-gradient(135deg, #17a2b8, #6610f2);
        color: white;
    }

    .view-btn:hover {
        background: linear-gradient(135deg, #138496, #5a0fc8);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(23, 162, 184, 0.3);
    }

    .edit-btn {
        background: linear-gradient(135deg, #ffc107, #fd7e14);
        color: white;
    }

    .edit-btn:hover {
        background: linear-gradient(135deg, #e0a800, #e8680d);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(255, 193, 7, 0.3);
    }

    .delete-btn {
        background: linear-gradient(135deg, #dc3545, #fd7e14);
        color: white;
    }

    .delete-btn:hover {
        background: linear-gradient(135deg, #c82333, #e8680d);
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(220, 53, 69, 0.3);
    }

    /* Card Body */
    .trainer-card-body {
        padding: 25px;
    }

    .trainer-info-section {
        margin-bottom: 20px;
    }

    .trainer-name {
        font-size: 1.5rem;
        font-weight: 700;
        color: #ffffff;
        margin-bottom: 8px;
    }

    .trainer-email {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #b0b0b0;
        font-size: 0.9rem;
    }

    .trainer-email i {
        color: #667eea;
    }

    .section-header {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        color: #ffffff;
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        margin-bottom: 10px;
    }

    .section-header i {
        color: #667eea;
        font-size: 1rem;
    }

    /* Specializations */
    .trainer-specializations {
        margin-bottom: 20px;
    }

    .specialization-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .specialization-tag {
        background: linear-gradient(135deg, #667eea, #764ba2);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    /* Gym Info */
    .trainer-gym {
        margin-bottom: 20px;
    }

    .gym-info {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .gym-name {
        font-weight: 600;
        color: #ffffff;
        font-size: 1rem;
    }

    .gym-address {
        color: #b0b0b0;
        font-size: 0.85rem;
    }

    /* Services */
    .trainer-services {
        margin-bottom: 0;
    }

    .service-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .service-tag {
        background: linear-gradient(135deg, #28a745, #20c997);
        color: white;
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .service-tag i {
        font-size: 0.7rem;
    }

    /* Empty State */
    .empty-state-section {
        background: linear-gradient(135deg, #2a2a2a 0%, #3d3d3d 100%);
        border-radius: 15px;
        padding: 60px 40px;
        text-align: center;
        box-shadow: 0 8px 32px rgba(0,0,0,0.3);
        border: 1px solid #404040;
    }

    .empty-state-content {
        max-width: 500px;
        margin: 0 auto;
    }

    .empty-icon {
        font-size: 4rem;
        color: #667eea;
        margin-bottom: 20px;
        opacity: 0.7;
    }

    .empty-title {
        color: #ffffff;
        font-size: 1.8rem;
        font-weight: 600;
        margin-bottom: 15px;
    }

    .empty-description {
        color: #b0b0b0;
        font-size: 1.1rem;
        margin-bottom: 30px;
    }

    /* Responsive Design */
    @@media (max-width: 768px) {
        .page-title {
            font-size: 1.8rem;
        }

        .trainers-grid {
            grid-template-columns: 1fr;
        }

        .trainer-card-header {
            flex-direction: column;
            gap: 15px;
            text-align: center;
        }

        .trainer-actions {
            width: 100%;
            justify-content: center;
        }
    }

    /* Animation for loading */
    @@keyframes fadeInUp {
        from {
            opacity: 0;
            transform: translateY(30px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .trainer-card-modern {
        animation: fadeInUp 0.5s ease-out;
    }

    .trainer-card-modern:nth-child(1) { animation-delay: 0.1s; }
    .trainer-card-modern:nth-child(2) { animation-delay: 0.2s; }
    .trainer-card-modern:nth-child(3) { animation-delay: 0.3s; }
    .trainer-card-modern:nth-child(4) { animation-delay: 0.4s; }
</style>

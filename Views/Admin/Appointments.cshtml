@model IEnumerable<FitnessCenter.Models.Appointment>
@{
    ViewData["Title"] = "Randevu Yönetimi";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-calendar-check text-primary me-3"></i>
            Randevu Yönetimi
        </h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Panele Dön
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtre Butonları -->
    <div class="mb-4">
        <div class="btn-group" role="group">
            <a asp-action="Appointments" asp-route-status=""
               class="btn @(ViewBag.CurrentStatus == null ? "btn-primary" : "btn-outline-primary")">
                Tüm Randevular
            </a>
            <a asp-action="Appointments" asp-route-status="Pending"
               class="btn @(ViewBag.CurrentStatus == "Pending" ? "btn-warning" : "btn-outline-warning")">
                <i class="bi bi-hourglass-split me-1"></i>Bekleyen (@ViewBag.PendingCount)
            </a>
            <a asp-action="Appointments" asp-route-status="Approved"
               class="btn @(ViewBag.CurrentStatus == "Approved" ? "btn-success" : "btn-outline-success")">
                <i class="bi bi-check-circle me-1"></i>Onaylanan
            </a>
            <a asp-action="Appointments" asp-route-status="Rejected"
               class="btn @(ViewBag.CurrentStatus == "Rejected" ? "btn-danger" : "btn-outline-danger")">
                <i class="bi bi-x-circle me-1"></i>Reddedilen
            </a>
            <a asp-action="Appointments" asp-route-status="Completed"
               class="btn @(ViewBag.CurrentStatus == "Completed" ? "btn-info" : "btn-outline-info")">
                <i class="bi bi-check-circle-fill me-1"></i>Tamamlanan
            </a>
        </div>
    </div>

    @if (Model.Any())
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-lg-6 mb-4">
                    <div class="appointment-card card h-100 shadow-sm hover-lift">
                        <!-- Kart Başlığı -->
                        <div class="card-header text-white" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h5 class="mb-1">
                                        <i class="bi bi-calendar-event me-2"></i>
                                        Randevu #@item.Id.ToString("D6")
                                    </h5>
                                    <small class="opacity-75">@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</small>
                                </div>
                                <div class="text-end">
                                    @switch (item.Status)
                                    {
                                        case AppointmentStatus.Pending:
                                            <span class="badge bg-warning">
                                                <i class="bi bi-hourglass-split me-1"></i>Beklemede
                                            </span>
                                            break;
                                        case AppointmentStatus.Approved:
                                            <span class="badge bg-success">
                                                <i class="bi bi-check-circle-fill me-1"></i>Onaylandı
                                            </span>
                                            break;
                                        case AppointmentStatus.Rejected:
                                            <span class="badge bg-danger">
                                                <i class="bi bi-x-circle-fill me-1"></i>Reddedildi
                                            </span>
                                            break;
                                        case AppointmentStatus.Completed:
                                            <span class="badge bg-info">
                                                <i class="bi bi-check-circle-fill me-1"></i>Tamamlandı
                                            </span>
                                            break;
                                        case AppointmentStatus.Cancelled:
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-x-circle-fill me-1"></i>İptal Edildi
                                            </span>
                                            break;
                                    }
                                </div>
                            </div>
                        </div>

                        <!-- Kart İçeriği -->
                        <div class="card-body">
                            <!-- Tarih ve Saat -->
                            <div class="text-center mb-4">
                                <div class="date-display bg-light p-3 rounded-3">
                                    <div class="row align-items-center">
                                        <div class="col-4">
                                            <div class="day-name text-primary fw-bold">
                                                @item.AppointmentDate.ToString("ddd", new System.Globalization.CultureInfo("tr-TR"))
                                            </div>
                                            <div class="day-number display-6 fw-bold text-dark">
                                                @item.AppointmentDate.ToString("dd")
                                            </div>
                                            <div class="month-year text-muted small">
                                                @item.AppointmentDate.ToString("MMM yyyy", new System.Globalization.CultureInfo("tr-TR"))
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="time-display">
                                                <i class="bi bi-clock-fill text-primary fs-4"></i>
                                                <div class="time-text h5 fw-bold mt-2">
                                                    @item.AppointmentTime.ToString(@"hh\:mm")
                                                </div>
                                            </div>
                                        </div>
                                        <div class="col-4">
                                            <div class="duration-display">
                                                <i class="bi bi-stopwatch text-info fs-4"></i>
                                                <div class="duration-text small mt-2">
                                                    @item.Service?.DurationMinutes dk
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="row">
                                <!-- Üye Bilgileri -->
                                <div class="col-md-6 mb-3">
                                    <div class="info-box">
                                        <h6 class="text-primary mb-2">
                                            <i class="bi bi-person me-1"></i>Üye
                                        </h6>
                                        <div class="member-info">
                                            <div class="fw-bold">@item.Member?.FirstName @item.Member?.LastName</div>
                                            <small class="text-muted">@item.Member?.Email</small>
                                            @if (!string.IsNullOrEmpty(item.Member?.PhoneNumber))
                                            {
                                                <br><small class="text-muted">@item.Member?.PhoneNumber</small>
                                            }
                                        </div>
                                    </div>
                                </div>

                                <!-- Antrenör Bilgileri -->
                                <div class="col-md-6 mb-3">
                                    <div class="info-box">
                                        <h6 class="text-primary mb-2">
                                            <i class="bi bi-person-badge me-1"></i>Antrenör
                                        </h6>
                                        <div class="trainer-info">
                                            <div class="fw-bold">@item.Trainer?.FullName</div>
                                            <small class="text-muted">@item.Trainer?.Specializations</small>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Hizmet Bilgileri -->
                            <div class="mb-3">
                                <div class="info-box">
                                    <h6 class="text-primary mb-2">
                                        <i class="bi bi-tools me-1"></i>Hizmet
                                    </h6>
                                    <div class="service-info">
                                        <div class="fw-bold">@item.Service?.Name</div>
                                        <small class="text-muted">
                                            Süre: @item.Service?.DurationMinutes dk |
                                            Ücret: ₺@item.Service?.Price.ToString("N0")
                                        </small>
                                    </div>
                                </div>
                            </div>

                            <!-- Salon Bilgileri -->
                            <div class="mb-3">
                                <div class="info-box">
                                    <h6 class="text-primary mb-2">
                                        <i class="bi bi-geo-alt me-1"></i>Salon
                                    </h6>
                                    <div class="gym-info">
                                        <div class="fw-bold">@item.Trainer?.FitnessCenter?.Name</div>
                                        <small class="text-muted">@item.Trainer?.FitnessCenter?.Address</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Notlar -->
                            @if (!string.IsNullOrEmpty(item.Notes))
                            {
                                <div class="mb-3">
                                    <div class="info-box">
                                        <h6 class="text-primary mb-2">
                                            <i class="bi bi-sticky me-1"></i>Not
                                        </h6>
                                        <div class="notes-content bg-light p-2 rounded small">
                                            @item.Notes
                                        </div>
                                    </div>
                                </div>
                            }

                            <!-- Güncellenme Tarihi -->
                            @if (item.UpdatedAt.HasValue)
                            {
                                <div class="mb-3">
                                    <small class="text-muted">
                                        <i class="bi bi-pencil me-1"></i>
                                        Son güncelleme: @item.UpdatedAt.Value.ToString("dd.MM.yyyy HH:mm")
                                    </small>
                                </div>
                            }
                        </div>

                        <!-- Kart Alt Kısmı - İşlemler -->
                        <div class="card-footer bg-light">
                            <div class="d-flex justify-content-between align-items-center">
                                <a asp-controller="Appointments" asp-action="Confirm" asp-route-id="@item.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i>Detay
                                </a>

                                <div class="action-buttons">
                                    @if (item.Status == AppointmentStatus.Pending)
                                    {
                                        <form asp-action="ApproveAppointment" asp-route-id="@item.Id" method="post"
                                              class="d-inline me-2"
                                              onsubmit="return confirm('Bu randevuyu onaylamak istediğinizden emin misiniz?')">
                                            <button type="submit" class="btn btn-success btn-sm">
                                                <i class="bi bi-check-circle me-1"></i>Onayla
                                            </button>
                                        </form>

                                        <form asp-action="RejectAppointment" asp-route-id="@item.Id" method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bu randevuyu reddetmek istediğinizden emin misiniz?')">
                                            <button type="submit" class="btn btn-danger btn-sm">
                                                <i class="bi bi-x-circle me-1"></i>Reddet
                                            </button>
                                        </form>
                                    }
                                    else if (item.Status == AppointmentStatus.Approved)
                                    {
                                        <form asp-action="CompleteAppointment" asp-route-id="@item.Id" method="post"
                                              class="d-inline"
                                              onsubmit="return confirm('Bu randevuyu tamamlandı olarak işaretlemek istediğinizden emin misiniz?')">
                                            <button type="submit" class="btn btn-info btn-sm">
                                                <i class="bi bi-check-circle-fill me-1"></i>Tamamlandı
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Randevu Yok Durumu -->
        <div class="text-center py-5">
            <div class="empty-state">
                <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
                <h3 class="mt-3 text-muted">
                    @if (ViewBag.CurrentStatus == "Pending")
                    {
                        <text>Bekleyen Randevu Yok</text>
                    }
                    else if (ViewBag.CurrentStatus == "Approved")
                    {
                        <text>Onaylanan Randevu Yok</text>
                    }
                    else if (ViewBag.CurrentStatus == "Rejected")
                    {
                        <text>Reddedilen Randevu Yok</text>
                    }
                    else if (ViewBag.CurrentStatus == "Completed")
                    {
                        <text>Tamamlanan Randevu Yok</text>
                    }
                    else
                    {
                        <text>Henüz Randevu Yok</text>
                    }
                </h3>
                <p class="text-muted">
                    @if (ViewBag.CurrentStatus == null)
                    {
                        <text>Randevular burada görünecek.</text>
                    }
                    else
                    {
                        <text>Bu kategoride randevu bulunmuyor.</text>
                    }
                </p>
            </div>
        </div>
    }
</div>

<style>
    .appointment-card {
        transition: all 0.3s ease;
        border: 1px solid #e9ecef;
        border-radius: 15px;
        overflow: hidden;
    }

    .hover-lift:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 25px rgba(0,0,0,0.15) !important;
    }

    .date-display {
        border: 2px solid #dee2e6 !important;
    }

    .info-box {
        background: #f8f9fa;
        padding: 15px;
        border-radius: 10px;
        height: 100%;
    }

    .day-name {
        font-size: 0.9rem;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .month-year {
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .time-display, .duration-display {
        display: flex;
        flex-direction: column;
        align-items: center;
    }

    .time-text, .duration-text {
        margin-top: 5px;
    }

    .card-header {
        border-bottom: none !important;
    }

    .card-footer {
        border-top: 1px solid #dee2e6 !important;
        background: #f8f9fa !important;
    }

    .empty-state {
        max-width: 400px;
        margin: 0 auto;
    }

    .badge {
        font-size: 0.75rem;
        padding: 0.375rem 0.75rem;
    }
</style>

@model FitnessCenter.Models.Service

@{
    ViewData["Title"] = "Hizmet Düzenle";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-pencil me-2"></i>Hizmet Düzenle
                    </h5>
                </div>
                <div class="card-body">
                    <form asp-action="EditService" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Hizmet Adı *</label>
                            <input asp-for="Name" class="form-control" required />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3"
                                      placeholder="Hizmet hakkında kısa bir açıklama..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="ServiceType" class="form-label">Hizmet Türü *</label>
                                <select asp-for="ServiceType" asp-items="ViewBag.ServiceTypes" class="form-select" required>
                                    <option value="">Seçiniz...</option>
                                </select>
                                <span asp-validation-for="ServiceType" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="FitnessCenterId" class="form-label">Spor Salonu *</label>
                                <select asp-for="FitnessCenterId" asp-items="ViewBag.FitnessCenters" class="form-select" required>
                                    <option value="">Seçiniz...</option>
                                </select>
                                <span asp-validation-for="FitnessCenterId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="DurationMinutes" class="form-label">Süre (Dakika) *</label>
                                <input asp-for="DurationMinutes" class="form-control" type="number" min="1" max="480" required />
                                <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Price" class="form-label">Ücret (TL) *</label>
                                <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" required />
                                <span asp-validation-for="Price" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-circle me-2"></i>Güncelle
                            </button>
                            <a asp-action="Services" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Geri Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}


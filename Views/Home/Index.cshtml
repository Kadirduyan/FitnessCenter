                        {
                            <a asp-controller="Account" asp-action="Register" class="btn btn-warning btn-lg mt-4">Kayıt Ol</a>
                        }
                        else
                        {
                            <a asp-controller="Appointments" asp-action="Create" class="btn btn-warning btn-lg mt-4">Randevu Al</a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <!-- Slide 2 -->
        <div class="carousel-item">
            <div class="hero-slide" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1584464491033-06628f3a6b7b?w=1920&q=80');">
                <div class="hero-content">
                    <div class="hero-text">
                        <h1 class="hero-title">YAPAY ZEKA DESTEKLİ</h1>
                        <div class="hero-logo">FITNESS</div>
                        <h2 class="hero-subtitle">KİŞİSELLEŞTİRİLMİŞ DENEYİM</h2>
                        <p class="hero-description">Ekipmanlarınız size uyum sağlar. Tahmin yok, sadece ilerleme.</p>
                        <a href="#fitness" class="btn btn-warning btn-lg mt-4">Daha Fazla Bilgi</a>
                    </div>
                </div>
            </div>
        </div>
        <!-- Slide 3 -->
        <div class="carousel-item">
            <div class="hero-slide" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1540497077202-7c8a3999166f?w=1920&q=80');">
                <div class="hero-content">
                    <div class="hero-text">
                        <h1 class="hero-title">SAĞLIK VE UZUN ÖMÜR İÇİN</h1>
                        <div class="hero-logo">FITNESS YAPARAK</div>
                        <h2 class="hero-subtitle">BİYOLOJİK YAŞINIZI İYİLEŞTİRİN</h2>
                        <p class="hero-description">Sağlık ve uzun ömür konusundaki yeni buluşlarla biyolojik yaşınızı iyileştirin.</p>
                        <a href="#biohacking" class="btn btn-warning btn-lg mt-4">Keşfet</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Önceki</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Sonraki</span>
    </button>
</div>

<!-- Fitness Section -->
<section id="fitness" class="section-fitness">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <h2 class="section-title-large">FITNESS</h2>
                <p class="section-description">
                    Yapay zeka destekli fitness ekipmanları ile performansınızı takip edin. 
                    Rehberli güç, kardiyo ve mobilite antrenmanları. Yapay zeka teknolojisini 

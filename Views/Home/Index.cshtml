            </div>
            <div class="col-md-4 mb-4">
                <div class="class-card">
                    <h3 class="class-title">Haberler</h3>
                    <p class="class-description">
                        Yapay zeka destekli fitness teknolojilerimizle işbirliğimizi duyurmaktan gurur duyuyoruz.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Membership Section -->
<section id="membership" class="section-membership">
    <div class="container">
        <div class="membership-card">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h2 class="membership-title">KADIR FITNESS ÜYELİĞİ</h2>
                    <div class="membership-badges">
                        <span class="badge">Kişiselleştirilmiş Antrenman</span>
                    </div>
                    <ul class="membership-features">
                        <li><i class="bi bi-check-circle-fill"></i> Devrimci Teknoloji</li>
                        <li><i class="bi bi-check-circle-fill"></i> Yapay Zeka Destekli Antrenman Planları</li>
                        <li><i class="bi bi-check-circle-fill"></i> Güçlendirici Atmosfer</li>
                        <li><i class="bi bi-check-circle-fill"></i> Ücretsiz Sınıflar</li>
                        <li><i class="bi bi-check-circle-fill"></i> Etkinlikler</li>
                    </ul>
                    @if (!User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-warning btn-lg">Şimdi Katıl</a>
                    }
                </div>
                <div class="col-lg-6">
                    <div class="membership-image">
                        <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=800&q=80" 
                             alt="Membership" class="img-fluid rounded">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

    @section Scripts {
        <script>
            // Smooth scroll for anchor links
            document.querySelectorAll('a[href^="#"]').forEach(anchor => {
                anchor.addEventListener('click', function (e) {
                    e.preventDefault();
                    const target = document.querySelector(this.getAttribute('href'));
                    if (target) {
                        target.scrollIntoView({
                            behavior: 'smooth',
                            block: 'start'
                        });
                    }
                }
            });
        </script>
    }
}

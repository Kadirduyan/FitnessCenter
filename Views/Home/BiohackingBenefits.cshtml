@{
    ViewData["Title"] = "Akıllı Antrenman Programı & Beslenme Rehberliği";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="text-center mb-5">
                <h1 class="display-4 fw-bold text-primary mb-3">
                    <i class="bi bi-robot me-3"></i>Akıllı Antrenman Programı
                </h1>
                <p class="lead text-muted">Yapay zeka destekli sistemimizle kişiselleştirilmiş fitness deneyimi yaşayın.</p>
            </div>

            <!-- Ana Özellikler -->
            <div class="row g-4 mb-5">
                <div class="col-md-4">
                    <div class="card h-100 shadow-lg border-0 text-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); color: white;">
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <i class="bi bi-cpu-fill fs-1"></i>
                            </div>
                            <h4 class="card-title">Yapay Zeka Analizi</h4>
                            <p class="card-text">Vücut tipiniz, hedefleriniz ve mevcut kondisyonunuz analiz edilerek özel program oluşturulur.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 shadow-lg border-0 text-center" style="background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%); color: white;">
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <i class="bi bi-graph-up-arrow fs-1"></i>
                            </div>
                            <h4 class="card-title">İlerleme Takibi</h4>
                            <p class="card-text">Antrenmanlarınızın etkisini gerçek zamanlı takip edin, motivasyonunuzu yüksek tutun.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-4">
                    <div class="card h-100 shadow-lg border-0 text-center" style="background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%); color: white;">
                        <div class="card-body p-4">
                            <div class="mb-3">
                                <i class="bi bi-apple fs-1"></i>
                            </div>
                            <h4 class="card-title">Beslenme Rehberi</h4>
                            <p class="card-text">Makro besin dengesi ve kalori hesaplama ile bilinçli beslenme alışkanlığı kazanın.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Detaylı Bilgiler -->
            <div class="row mb-5">
                <div class="col-lg-8 mx-auto">
                    <div class="card shadow-lg border-0">
                        <div class="card-header bg-primary text-white text-center py-4">
                            <h3 class="mb-0">
                                <i class="bi bi-lightbulb-fill me-2"></i>
                                Program Özellikleri
                            </h3>
                        </div>
                        <div class="card-body p-4">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <h5 class="text-primary mb-3">
                                        <i class="bi bi-person-check me-2"></i>Kişiselleştirme
                                    </h5>
                                    <ul class="list-unstyled">
                                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Vücut analizi</li>
                                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Hedef belirleme</li>
                                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Seviye tespiti</li>
                                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Rutin oluşturma</li>
                                    </ul>
                                </div>
                                <div class="col-md-6">
                                    <h5 class="text-primary mb-3">
                                        <i class="bi bi-bar-chart-line me-2"></i>Takip Sistemi
                                    </h5>
                                    <ul class="list-unstyled">
                                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Günlük rapor</li>
                                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>İlerleme grafikleri</li>
                                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Motivasyon bildirimleri</li>
                                        <li class="mb-2"><i class="bi bi-check-circle-fill text-success me-2"></i>Uyarı sistemi</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Web Programımız -->
            <div class="row mb-5">
                <div class="col-12">
                    <div class="card shadow-lg border-0" style="background: linear-gradient(135deg, #a8edea 0%, #fed6e3 100%);">
                        <div class="card-body p-5 text-center">
                            <h3 class="text-dark mb-4">
                                <i class="bi bi-globe me-2"></i>Web Programımız
                            </h3>
                            <div class="row g-4">
                                <div class="col-md-3">
                                    <div class="feature-box">
                                        <i class="bi bi-phone fs-2 text-primary mb-2"></i>
                                        <h6>Mobil Erişim</h6>
                                        <p class="small">Her yerden programınıza erişin</p>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="feature-box">
                                        <i class="bi bi-chat-dots fs-2 text-success mb-2"></i>
                                        <h6>Antrenör Sohbeti</h6>
                                        <p class="small">Profesyonel destek alın</p>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="feature-box">
                                        <i class="bi bi-trophy fs-2 text-warning mb-2"></i>
                                        <h6>Razılar</h6>
                                        <p class="small">Başarılarınızı paylaşın</p>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="feature-box">
                                        <i class="bi bi-graph-up fs-2 text-info mb-2"></i>
                                        <h6>Analitik</h6>
                                        <p class="small">Detaylı performans analizi</p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Örnek Program -->
            <div class="row mb-5">
                <div class="col-lg-10 mx-auto">
                    <h3 class="text-center mb-4 text-primary">
                        <i class="bi bi-calendar-week me-2"></i>Örnek Haftalık Program
                    </h3>
                    <div class="card shadow-lg border-0">
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover mb-0">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Gün</th>
                                            <th>Antrenman Türü</th>
                                            <th>Süre</th>
                                            <th>Zorluk</th>
                                            <th>Kalori</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <tr>
                                            <td><strong>Pazartesi</strong></td>
                                            <td>Güç Antrenmanı</td>
                                            <td>60 dk</td>
                                            <td><span class="badge bg-warning">Orta</span></td>
                                            <td>350 kcal</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Salı</strong></td>
                                            <td>Kardiyo</td>
                                            <td>45 dk</td>
                                            <td><span class="badge bg-success">Kolay</span></td>
                                            <td>280 kcal</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Çarşamba</strong></td>
                                            <td>Yoga</td>
                                            <td>50 dk</td>
                                            <td><span class="badge bg-info">Başlangıç</span></td>
                                            <td>180 kcal</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Perşembe</strong></td>
                                            <td>HIIT</td>
                                            <td>30 dk</td>
                                            <td><span class="badge bg-danger">Zor</span></td>
                                            <td>400 kcal</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Cuma</strong></td>
                                            <td>Pilates</td>
                                            <td>45 dk</td>
                                            <td><span class="badge bg-warning">Orta</span></td>
                                            <td>220 kcal</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Cumartesi</strong></td>
                                            <td>Dinlenme</td>
                                            <td>-</td>
                                            <td><span class="badge bg-secondary">Dinlenme</span></td>
                                            <td>-</td>
                                        </tr>
                                        <tr>
                                            <td><strong>Pazar</strong></td>
                                            <td>Yürüyüş</td>
                                            <td>60 dk</td>
                                            <td><span class="badge bg-success">Kolay</span></td>
                                            <td>250 kcal</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="text-center">
                <a asp-controller="Ai" asp-action="Index" class="btn btn-primary btn-lg me-3">
                    <i class="bi bi-robot me-2"></i>AI Önerilerini Gör
                </a>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-primary btn-lg">
                    <i class="bi bi-house me-2"></i>Ana Sayfaya Dön
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Sayfa animasyonları
        document.addEventListener('DOMContentLoaded', function() {
            const cards = document.querySelectorAll('.card');
            const observer = new IntersectionObserver((entries) => {
                entries.forEach(entry => {
                    if (entry.isIntersecting) {
                        entry.target.style.opacity = '0';
                        entry.target.style.transform = 'translateY(30px)';
                        entry.target.style.transition = 'opacity 0.6s ease, transform 0.6s ease';

                        setTimeout(() => {
                            entry.target.style.opacity = '1';
                            entry.target.style.transform = 'translateY(0)';
                        }, 200);
                    }
                });
            });

            cards.forEach(card => observer.observe(card));
        });
    </script>
}

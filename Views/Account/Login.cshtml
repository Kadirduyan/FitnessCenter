@model FitnessCenter.Controllers.LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-custom login-card">
                <div class="card-header login-card-header text-center">
                    <h4 class="mb-0 login-card-title">
                        <i class="bi bi-shield-lock me-2"></i>Rol Bazlı Giriş Sistemi
                    </h4>
                </div>
                <div class="card-body p-4 login-card-body">

                    <!-- Rol Seçimi Tab'ları -->
                    <ul class="nav nav-tabs mb-4 login-tabs" id="loginTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link login-tab @(ViewBag.IsAdminLogin == true ? "" : "active")" id="member-tab" data-bs-toggle="tab" data-bs-target="#member-login" type="button" role="tab">
                                <i class="bi bi-person me-2"></i>Üye Girişi
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link login-tab @(ViewBag.IsAdminLogin == true ? "active" : "")" id="admin-tab" data-bs-toggle="tab" data-bs-target="#admin-login" type="button" role="tab">
                                <i class="bi bi-shield-check me-2"></i>Admin Girişi
                            </button>
                        </li>
                    </ul>

                    <!-- Tab İçerikleri -->
                    <div class="tab-content" id="loginTabsContent">

                        <!-- Üye Girişi -->
                        <div class="tab-pane fade @(ViewBag.IsAdminLogin == true ? "" : "show active")" id="member-login" role="tabpanel">
                            <h5 class="text-center mb-3 login-section-title">
                                <i class="bi bi-person-circle me-2"></i>Üye Girişi
                            </h5>
                            <form asp-action="Login" method="post" id="memberLoginForm">
                                <input type="hidden" asp-for="IsAdminLogin" value="false" />
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label login-label">
                                        <i class="bi bi-envelope me-1"></i>E-posta
                                    </label>
                                    <input asp-for="Email" class="form-control login-input" placeholder="E-posta adresinizi giriniz" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label login-label">
                                        <i class="bi bi-lock me-1"></i>Şifre
                                    </label>
                                    <input asp-for="Password" class="form-control login-input" placeholder="Şifrenizi giriniz" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>

                                <div class="mb-3 form-check">
                                    <input asp-for="RememberMe" class="form-check-input login-checkbox" />
                                    <label asp-for="RememberMe" class="form-check-label login-checkbox-label">Beni Hatırla</label>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-lg login-button-member">
                                        <i class="bi bi-box-arrow-in-right me-2"></i>Üye Olarak Giriş Yap
                                    </button>
                                </div>
                            </form>
                        </div>

                        <!-- Admin Girişi -->
                        <div class="tab-pane fade @(ViewBag.IsAdminLogin == true ? "show active" : "")" id="admin-login" role="tabpanel">
                            <h5 class="text-center mb-3 login-section-title-admin">
                                <i class="bi bi-shield-lock me-2"></i>Admin Girişi
                            </h5>

                            <div class="alert login-alert-warning mb-3">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                <strong>Admin Girişi:</strong><br>
                                Sadece yetkili personel için
                            </div>

                            <form asp-action="Login" method="post" id="adminLoginForm">
                                <input type="hidden" name="IsAdminLogin" value="true" />
                                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                                <div class="mb-3">
                                    <label asp-for="Email" class="form-label login-label">
                                        <i class="bi bi-envelope me-1"></i>Admin E-posta
                                    </label>
                                    <input asp-for="Email" class="form-control login-input" id="adminEmail" name="Email" placeholder="Admin e-posta adresi" />
                                    <span asp-validation-for="Email" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Password" class="form-label login-label">
                                        <i class="bi bi-lock me-1"></i>Admin Şifre
                                    </label>
                                    <input asp-for="Password" class="form-control login-input" id="adminPassword" name="Password" type="password" placeholder="Admin şifresi" />
                                    <span asp-validation-for="Password" class="text-danger"></span>
                                </div>

                                <div class="mb-3 form-check">
                                    <input asp-for="RememberMe" class="form-check-input login-checkbox" name="RememberMe" type="checkbox" />
                                    <label asp-for="RememberMe" class="form-check-label login-checkbox-label">Beni Hatırla</label>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-lg login-button-admin">
                                        <i class="bi bi-shield-check me-2"></i>Admin Olarak Giriş Yap
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <hr class="my-4 login-divider">

                    <div class="text-center">
                        <p class="mb-2 login-footer-text">
                            <i class="bi bi-person-plus me-1"></i>
                            Üye hesabınız yok mu?
                            <a asp-action="Register" class="text-decoration-none fw-bold login-link">Ücretsiz Kayıt Olun</a>
                        </p>
                        <small class="login-footer-small">
                            KADIR Fitness ile sağlıklı yaşam yolculuğunuza başlayın!
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function showToast(message, type) {
            // Basit toast mesajı
            const toastHtml = `
                <div class="toast align-items-center text-white bg-${type} border-0 position-fixed top-0 end-0 m-3" role="alert">
                    <div class="d-flex">
                        <div class="toast-body">${message}</div>
                        <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
                    </div>
                </div>
            `;

            document.body.insertAdjacentHTML('beforeend', toastHtml);
            const toastElement = document.querySelector('.toast:last-child');
            const toast = new bootstrap.Toast(toastElement);
            toast.show();

            // 3 saniye sonra kaldır
            setTimeout(() => {
                toastElement.remove();
            }, 3000);
        }

        // Sayfa yüklendiğinde
        document.addEventListener('DOMContentLoaded', function() {
            // Tab değiştiğinde formları ayır
            const tabs = document.querySelectorAll('#loginTabs .nav-link');
        });

        // Admin bilgilerini manuel doldurma (kullanılmıyor)
        function fillAdminCredentials() {
            // Bu fonksiyon artık kullanılmıyor - güvenlik nedeniyle kaldırıldı
            showToast('Admin bilgileri otomatik doldurulamaz!', 'danger');
        }
    </script>
}


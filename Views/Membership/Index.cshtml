        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
    }

    /* Dark Theme Enhancements */
    main.user-authenticated .bg-gradient-primary {
        background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%) !important;
        color: #1a1a1a !important;
    }

    main.user-authenticated .card-header.bg-primary {
        background: linear-gradient(135deg, #ffc107 0%, #ff9800 100%) !important;
        color: #1a1a1a !important;
    }

    main.user-authenticated .card-header.bg-primary h6,
    main.user-authenticated .card-header.bg-primary i {
        color: #1a1a1a !important;
    }

    main.user-authenticated .card-header.bg-success {
        background: linear-gradient(135deg, #28a745 0%, #1e7e34 100%) !important;
        color: #ffffff !important;
    }

    main.user-authenticated .card-header.bg-success h6,
    main.user-authenticated .card-header.bg-success i {
        color: #ffffff !important;
    }

    .info-item {
        margin-bottom: 12px;
        padding: 8px 0;
        border-bottom: 1px solid #f8f9fa;
    }

    .info-item:last-child {
        border-bottom: none;
    }

    .card {
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

    .card-header {
        border-bottom: none !important;
    }

    .card-footer {
        border-top: 1px solid #dee2e6 !important;
        background: #f8f9fa !important;
    }

    /* Dark Theme Card Footer */
    main.user-authenticated .card-footer {
        border-top: 1px solid #555555 !important;
        background: linear-gradient(135deg, #2a2a2a 0%, #1e1e1e 100%) !important;
    }

    .progress {
        border-radius: 10px;
    }

    .progress-bar {
        border-radius: 10px;
    }

    .countdown-timer {
        font-family: 'Courier New', monospace;
        font-size: 1.1em;
    }

    .circular-timer-container {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .circular-timer {
        position: relative;
        width: 80px;
        height: 80px;
    }

    .circular-timer svg circle {
        transition: stroke-dashoffset 0.5s ease;
    }

    .timer-text {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        font-size: 20px;
        font-weight: bold;
        color: #ffd700;
        text-shadow: 0 2px 4px rgba(0,0,0,0.5);
    }

    .timer-label {
        position: absolute;
        top: 65%;
        left: 50%;
        transform: translateX(-50%);
        font-size: 11px;
        color: #ffc107;

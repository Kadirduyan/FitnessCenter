    }

    main.user-authenticated .membership-cancel-modal-header .modal-title {
        color: #ffffff !important;
        font-weight: 700;
    }

    main.user-authenticated .membership-cancel-modal-header .btn-close {
        filter: invert(1);
    }

    main.user-authenticated .membership-cancel-modal-body {
        background: linear-gradient(135deg, #2a2a2a 0%, #1e1e1e 100%) !important;
        color: #e0d4a0 !important;
    }

    main.user-authenticated .membership-cancel-modal-body p {
        color: #e0d4a0 !important;
    }

    main.user-authenticated .membership-cancel-modal-body strong {
        color: #ffd700 !important;
    }

    main.user-authenticated .membership-cancel-warning-box {
        background: linear-gradient(135deg, #3a1a1a 0%, #2a0f0f 100%) !important;
        border: 2px solid #dc3545 !important;
        border-radius: 8px;
        padding: 16px;
        margin: 16px 0;
    }

    main.user-authenticated .membership-cancel-warning-box h6 {
        color: #ff6b6b !important;
        font-weight: 700;
    }

    main.user-authenticated .membership-cancel-warning-box p {
        color: #ffcccc !important;
    }

    main.user-authenticated .membership-cancel-warning-box i {
        color: #ff6b6b !important;
    }

    main.user-authenticated .membership-cancel-modal-footer {
        background: linear-gradient(135deg, #2a2a2a 0%, #1e1e1e 100%) !important;
        border-top: 1px solid #555555 !important;
    }

    main.user-authenticated .membership-cancel-modal-footer .btn-secondary {
        background: linear-gradient(135deg, #6c757d 0%, #5a6268 100%) !important;
        border: none !important;
        color: #ffffff !important;
    }

    main.user-authenticated .membership-cancel-modal-footer .btn-danger {
        background: linear-gradient(135deg, #dc3545 0%, #c82333 100%) !important;
        border: none !important;
        color: #ffffff !important;
        font-weight: 600;
    }

    main.user-authenticated .membership-cancel-modal-footer .btn-danger:hover {
        background: linear-gradient(135deg, #c82333 0%, #bd2130 100%) !important;
    }
</style>

@section Scripts {
    <script>
        // Üyelik bitiş tarihi (C# model'den al)
        const endDate = new Date('@Model.EndDate.ToString("yyyy-MM-ddTHH:mm:ss")');
        const countdownElement = document.getElementById('countdown-timer');

        function updateCountdown() {
            const now = new Date();
            const timeLeft = endDate - now;

            if (timeLeft <= 0) {
                document.getElementById('timer-text').textContent = '0';
                document.getElementById('countdown-timer').innerHTML = '<span class="text-danger">Süre Doldu!</span>';
                document.getElementById('progress-circle').style.strokeDashoffset = '219.91';
                return;
            }

            // Zamanı hesapla
            const days = Math.floor(timeLeft / (1000 * 60 * 60 * 24));
            const hours = Math.floor((timeLeft % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
            const minutes = Math.floor((timeLeft % (1000 * 60 * 60)) / (1000 * 60));
            const seconds = Math.floor((timeLeft % (1000 * 60)) / 1000);

            // Progress circle için stroke-dashoffset hesapla (219.91 = 2 * π * 35)
            const totalSeconds = days * 24 * 60 * 60 + hours * 60 * 60 + minutes * 60 + seconds;
            const maxSeconds = 30 * 24 * 60 * 60; // 30 gün max
            const progress = Math.max(0, 1 - (totalSeconds / maxSeconds));
            const circumference = 2 * Math.PI * 35;
            const strokeDashoffset = circumference * progress;

            // Renk belirle - Enhanced for dark theme
            let colorClass = 'text-success';
            let strokeColor = '#28a745';
            if (days <= 7) {
                colorClass = 'text-danger';
                strokeColor = '#dc3545';
            } else if (days <= 14) {
                colorClass = 'text-warning';
                strokeColor = '#ffc107';
            }

            // Circular timer'ı güncelle
            document.getElementById('timer-text').textContent = days;
            document.getElementById('progress-circle').style.stroke = strokeColor;
            document.getElementById('progress-circle').style.strokeDashoffset = strokeDashoffset;

            // Detaylı zamanı güncelle
            let html = '';
            if (days > 0) {
                html += `${days} gün `;
            }
            if (hours > 0 || days > 0) {
                html += `${hours.toString().padStart(2, '0')}:`;
            }
            html += `${minutes.toString().padStart(2, '0')}:${seconds.toString().padStart(2, '0')}`;

            countdownElement.innerHTML = html;
            countdownElement.className = `${colorClass} fw-bold countdown-timer`;
        }

        // Sayfa yüklendiğinde başlat
        document.addEventListener('DOMContentLoaded', function() {
            updateCountdown();
            // Her saniye güncelle
            setInterval(updateCountdown, 1000);
        });
    </script>
}

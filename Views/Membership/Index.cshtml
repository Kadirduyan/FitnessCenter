@model FitnessCenter.Models.Membership
@{
    ViewData["Title"] = "Üyeliğim";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="display-5 fw-bold">
            <i class="bi bi-person-badge text-primary me-3"></i>
            Üyeliğim
        </h1>
        <div>
            <a asp-action="Purchase" class="btn btn-outline-primary me-2">
                <i class="bi bi-plus-circle me-1"></i>Yeni Üyelik
            </a>
            <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-house me-1"></i>Ana Sayfa
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row">
        <!-- Üyelik Durumu Kartı -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="bi bi-card-text me-2"></i>
                            Üyelik Bilgileri
                        </h5>
                        <span class="badge bg-@Model.StatusColor fs-6">
                            @Model.StatusText
                        </span>
                    </div>
                </div>

                <div class="card-body p-4">
                    <div class="row">
                        <!-- Sol Kolon - Üyelik Detayları -->
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-calendar-event me-2"></i>Üyelik Dönemi
                                </h6>
                                <div class="info-item">
                                    <strong>Başlangıç:</strong> @Model.StartDate.ToString("dd.MM.yyyy")
                                </div>
                                <div class="info-item">
                                    <strong>Bitiş:</strong> @Model.EndDate.ToString("dd.MM.yyyy")
                                </div>
                                <div class="info-item">
                                    <strong>Kalan Süre:</strong>
                                    <div class="circular-timer-container">
                                        <div class="circular-timer" id="circular-timer">
                                            <svg width="80" height="80" viewBox="0 0 80 80">
                                                <circle cx="40" cy="40" r="35" stroke="#555555" stroke-width="8" fill="none" opacity="0.3" class="bg-circle"/>
                                                <circle cx="40" cy="40" r="35" stroke="@(Model.DaysRemaining <= 7 ? "#dc3545" : Model.DaysRemaining <= 14 ? "#ffc107" : "#28a745")"
                                                        stroke-width="8" fill="none" stroke-linecap="round"
                                                        stroke-dasharray="219.91" stroke-dashoffset="0" id="progress-circle"
                                                        transform="rotate(-90 40 40)" class="progress-circle"/>
                                            </svg>
                                            <div class="timer-text" id="timer-text">
                                                @Model.DaysRemaining
                                            </div>
                                            <div class="timer-label">gün</div>
                                        </div>
                                        <div id="countdown-timer" class="countdown-detail @(Model.DaysRemaining <= 7 ? "text-danger" : "text-success")">
                                            @Model.DaysRemaining gün
                                        </div>
                                    </div>
                                </div>
                                <div class="info-item">
                                    <strong>Tür:</strong> @Model.MembershipType.GetDisplayName()
                                </div>
                                <div class="info-item">
                                    <strong>Ücret:</strong> ₺@Model.Price.ToString("N0")
                                </div>
                            </div>

                            <!-- İlerleme Çubuğu -->
                            <div class="mb-4">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-graph-up me-2"></i>Üyelik İlerlemesi
                                </h6>
                                <div class="progress" style="height: 20px;">
                                    <div class="progress-bar bg-@Model.StatusColor"
                                         role="progressbar"
                                         style="width: @Model.ProgressPercentage%"
                                         aria-valuenow="@Model.ProgressPercentage"
                                         aria-valuemin="0"
                                         aria-valuemax="100">
                                        @(Math.Round(Model.ProgressPercentage, 1))%
                                    </div>
                                </div>
                                <small class="text-muted mt-1 d-block">
                                    Üyeliğinizin @(Math.Round(Model.ProgressPercentage, 1))% tamamlandı
                                </small>
                            </div>
                        </div>

                        <!-- Sağ Kolon - Kart Bilgileri -->
                        <div class="col-md-6">
                            <div class="mb-4">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-credit-card me-2"></i>Kart Bilgileri
                                </h6>
                                <div class="info-item">
                                    <strong>Kart Sahibi:</strong> @Model.CardHolderName
                                </div>
                                <div class="info-item">
                                    <strong>Kart Numarası:</strong> **** **** **** @(Model.CardNumber?.Length >= 4 ? Model.CardNumber.Substring(Model.CardNumber.Length - 4) : "")
                                </div>
                                <div class="info-item">
                                    <strong>Son Kullanma:</strong> @Model.CardExpiryDate
                                </div>
                                <div class="info-item">
                                    <strong>CVV:</strong> ***
                                </div>
                            </div>

                            <!-- Otomatik Yenileme -->
                            <div class="mb-4">
                                <h6 class="text-primary mb-3">
                                    <i class="bi bi-arrow-repeat me-2"></i>Otomatik Yenileme
                                </h6>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox"
                                           id="autoRenew" @(Model.AutoRenew ? "checked" : "") disabled>
                                    <label class="form-check-label" for="autoRenew">
                                        @(Model.AutoRenew ? "Aktif" : "Pasif")
                                    </label>
                                </div>
                                <small class="text-muted">
                                    Otomatik yenileme ayarı için lütfen bizimle iletişime geçin.
                                </small>
                            </div>
                        </div>
                    </div>

                    <!-- Uyarı Bölümü -->
                    @if (Model.DaysRemaining <= 7 && Model.DaysRemaining > 0)
                    {
                        <div class="alert alert-warning mt-4">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Uyarı!</strong> Üyeliğiniz @Model.DaysRemaining gün sonra bitecek.
                            Üyeliğinizi yenilemek için "Üyeliği Yenile" butonunu kullanabilirsiniz.
                        </div>
                    }
                    else if (Model.DaysRemaining == 0)
                    {
                        <div class="alert alert-danger mt-4">
                            <i class="bi bi-exclamation-triangle me-2"></i>
                            <strong>Üyeliğiniz Sona Erdi!</strong>
                            Devam etmek için yeni bir üyelik satın alın.
                        </div>
                    }
                </div>

                <!-- Kart Alt Kısmı - İşlemler -->
                <div class="card-footer bg-light">
                    <div class="d-flex justify-content-between align-items-center">
                        @if (Model.IsActive && Model.DaysRemaining > 0)
                        {
                            <form asp-action="Renew" asp-route-id="@Model.Id" method="post"
                                  class="d-inline"
                                  onsubmit="return confirm('Üyeliğinizi yenilemek istediğinizden emin misiniz?')">
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-arrow-repeat me-1"></i>Üyeliği Yenile
                                </button>
                            </form>
                        }
                        else if (!Model.IsActive)
                        {
                            <a asp-action="Purchase" class="btn btn-primary">
                                <i class="bi bi-plus-circle me-1"></i>Yeni Üyelik Al
                            </a>
                        }

                        <div class="text-end">
                            @if (Model.IsActive)
                            {
                                <button type="button" class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#cancelMembershipModal">
                                    <i class="bi bi-x-circle me-1"></i>Üyeliği İptal Et
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sağ Kolon - Özet Bilgiler -->
        <div class="col-lg-4">
            <!-- Üyelik Özeti -->
            <div class="card shadow mb-4">
                <div class="card-header bg-primary text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-info-circle me-2"></i>Üyelik Özeti
                    </h6>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Üyelik Türü:</span>
                        <strong>@Model.MembershipType.GetDisplayName()</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Aylık Ücret:</span>
                        <strong>₺3.000</strong>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Toplam Tutar:</span>
                        <strong>₺@Model.Price.ToString("N0")</strong>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span>Kalan Süre:</span>
                        <strong class="@(Model.DaysRemaining <= 7 ? "text-danger" : "text-success")">
                            @Model.DaysRemaining gün
                        </strong>
                    </div>
                </div>
            </div>

            <!-- Avantajlar -->
            <div class="card shadow">
                <div class="card-header bg-success text-white">
                    <h6 class="mb-0">
                        <i class="bi bi-star me-2"></i>Üyelik Avantajları
                    </h6>
                </div>
                <div class="card-body">
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Profesyonel Antrenörler
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Tüm Ekipman Kullanımı
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Ücretsiz Grup Dersleri
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            Kişisel Antrenman İndirimi
                        </li>
                        <li class="mb-0">
                            <i class="bi bi-check-circle-fill text-success me-2"></i>
                            AI Destekli Program
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Üyelik İptal Onay Modal -->
<div class="modal fade" id="cancelMembershipModal" tabindex="-1" aria-labelledby="cancelMembershipModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content membership-cancel-modal">
            <div class="modal-header membership-cancel-modal-header">
                <h5 class="modal-title" id="cancelMembershipModalLabel">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Üyelik İptal Onayı
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body membership-cancel-modal-body">
                <div class="alert alert-danger mb-3">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>ÖNEMLİ UYARI!</strong>
                </div>
                <p class="mb-3">
                    Üyeliğinizi iptal etmek istediğinizden emin misiniz?
                </p>
                <div class="membership-cancel-warning-box">
                    <h6 class="mb-2">
                        <i class="bi bi-x-circle-fill me-2"></i>
                        Para İadesi Yapılmaz
                    </h6>
                    <p class="mb-0">
                        Üyeliğinizi iptal ettiğinizde, ödediğiniz ücret için <strong>para iadesi yapılmaz</strong>. 
                        Üyeliğiniz anında sona erecek ve kalan süre için erişim hakkınız kaybolacaktır.
                    </p>
                </div>
                <div class="mt-3">
                    <p class="mb-0">
                        <strong>İptal etmek istediğinizden emin misiniz?</strong>
                    </p>
                </div>
            </div>
            <div class="modal-footer membership-cancel-modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="bi bi-x-circle me-1"></i>İptal
                </button>
                <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-check-circle me-1"></i>Evet, İptal Et
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>

        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .countdown-detail {
        font-family: 'Courier New', monospace;
        font-size: 1.1em;
        font-weight: bold;
        padding: 8px 12px;
        background: linear-gradient(135deg, #2a2a2a 0%, #1e1e1e 100%);
        border: 1px solid #ffc107;
        border-radius: 8px;
        min-width: 120px;
        text-align: center;
    }

    /* Dark Theme Overrides */
    main.user-authenticated .timer-text {
        color: #ffd700 !important;
    }

    main.user-authenticated .timer-label {
        color: #ffc107 !important;
    }

    main.user-authenticated .countdown-detail {
        background: linear-gradient(135deg, #2a2a2a 0%, #1e1e1e 100%) !important;
        border-color: #ffc107 !important;
        color: #ffd700 !important;
    }

    main.user-authenticated .countdown-detail.text-success {
        color: #28a745 !important;
        border-color: #28a745 !important;
    }

    main.user-authenticated .countdown-detail.text-danger {
        color: #dc3545 !important;
        border-color: #dc3545 !important;
    }

    main.user-authenticated .circular-timer svg circle[stroke="#e9ecef"] {
        stroke: #555555 !important;
    }

    main.user-authenticated .info-item {
        border-bottom-color: #555555 !important;
        color: #e0d4a0;
    }

    main.user-authenticated .info-item strong {

@model FitnessCenter.Models.Membership
@{
    ViewData["Title"] = "Üyelik Satın Al";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="text-center mb-5">
                <h1 class="display-5 fw-bold mb-3 membership-header">
                    <i class="bi bi-person-badge-fill me-3"></i>
                    KADIR Fitness Üyeliği
                </h1>
                <p class="lead membership-subtitle">
                    Türkiye'nin ilk tam ölçekli yapay zeka destekli spor salonuna katılın
                </p>
                <div class="badge membership-badge fs-6 px-3 py-2">
                    <i class="bi bi-star-fill me-1"></i>
                    Aylık Sadece ₺3.000
                </div>
            </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow" role="alert">
            <i class="bi bi-exclamation-triangle me-2"></i>
            <strong>Form Hatası:</strong> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-warning alert-dismissible fade show shadow" role="alert">
            <i class="bi bi-info-circle me-2"></i>
            <strong>Validasyon Hataları:</strong>
            <ul class="mb-0 mt-2">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

            <div class="card shadow-lg border-0 membership-card">
                <div class="card-header membership-card-header text-center py-4">
                    <h3 class="mb-1 membership-card-title">Üyelik Paketi Seçin</h3>
                    <p class="mb-0 membership-card-subtitle">Size en uygun paketi seçin ve hemen başlayın</p>
                </div>

                <form asp-action="Purchase" method="post" id="membershipForm">
        <input type="hidden" asp-for="MemberId" />
                    <div class="card-body p-4">
                        <!-- Üyelik Türü Seçimi -->
                        <div class="mb-4">
                            <h5 class="mb-3 membership-section-title">
                                <i class="bi bi-trophy me-2"></i>Üyelik Paketi
                            </h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <div class="membership-option" data-type="1">
                                        <div class="card h-100 membership-package-card membership-package-selected">
                                            <div class="card-body text-center">
                                                <h5 class="card-title membership-package-title">Aylık Üyelik</h5>
                                                <h3 class="fw-bold membership-package-price">₺3.000</h3>
                                                <p class="small mb-2 membership-package-period">1 Ay</p>
                                                <div class="form-check">
                                                    <input class="form-check-input membership-radio" type="radio"
                                                           asp-for="MembershipType" value="1" id="monthly" checked>
                                                    <label class="form-check-label membership-package-select" for="monthly">
                                                        <i class="bi bi-check-circle-fill me-1"></i>Seç
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="membership-option" data-type="3">
                                        <div class="card h-100 membership-package-card">
                                            <div class="card-body text-center">
                                                <h5 class="card-title membership-package-title">3 Aylık Üyelik</h5>
                                                <h3 class="fw-bold membership-package-price">₺8.000</h3>
                                                <p class="small mb-2 membership-package-discount">%10 İndirim</p>
                                                <div class="form-check">
                                                    <input class="form-check-input membership-radio" type="radio"
                                                           asp-for="MembershipType" value="3" id="quarterly">
                                                    <label class="form-check-label membership-package-select" for="quarterly">
                                                        Seç
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="membership-option" data-type="6">
                                        <div class="card h-100 membership-package-card">
                                            <div class="card-body text-center">
                                                <h5 class="card-title membership-package-title">6 Aylık Üyelik</h5>
                                                <h3 class="fw-bold membership-package-price">₺15.000</h3>
                                                <p class="small mb-2 membership-package-discount">%15 İndirim</p>
                                                <div class="form-check">
                                                    <input class="form-check-input membership-radio" type="radio"
                                                           asp-for="MembershipType" value="6" id="semiannual">
                                                    <label class="form-check-label membership-package-select" for="semiannual">
                                                        Seç
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <div class="membership-option" data-type="12">
                                        <div class="card h-100 membership-package-card">
                                            <div class="card-body text-center">
                                                <h5 class="card-title membership-package-title">Yıllık Üyelik</h5>
                                                <h3 class="fw-bold membership-package-price">₺28.000</h3>
                                                <p class="small mb-2 membership-package-discount">%20 İndirim</p>
                                                <div class="form-check">
                                                    <input class="form-check-input membership-radio" type="radio"
                                                           asp-for="MembershipType" value="12" id="annual">
                                                    <label class="form-check-label membership-package-select" for="annual">
                                                        Seç
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Kart Bilgileri -->
                        <div class="mb-4">
                            <h5 class="mb-3 membership-section-title">
                                <i class="bi bi-credit-card me-2"></i>Ödeme Bilgileri
                            </h5>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CardHolderName" class="form-label">Kart Sahibi Adı</label>
                                    <input asp-for="CardHolderName" class="form-control" placeholder="Ad Soyad" required />
                                    <span asp-validation-for="CardHolderName" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CardNumber" class="form-label">Kart Numarası</label>
                                    <input asp-for="CardNumber" class="form-control" placeholder="1234 5678 9012 3456" maxlength="16" required />
                                    <span asp-validation-for="CardNumber" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CardExpiryDate" class="form-label">Son Kullanma Tarihi</label>
                                    <input asp-for="CardExpiryDate" class="form-control" placeholder="12/25" maxlength="5" required />
                                    <span asp-validation-for="CardExpiryDate" class="text-danger"></span>
                                </div>
                                <div class="col-md-6 mb-3">
                                    <label asp-for="CardCVV" class="form-label">CVV Kodu</label>
                                    <input asp-for="CardCVV" class="form-control" placeholder="123" maxlength="4" required />
                                    <span asp-validation-for="CardCVV" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="alert membership-info-alert">
                                <i class="bi bi-info-circle me-2"></i>
                                <small>Kart bilgileriniz güvenli bir şekilde saklanmaktadır ve sadece üyelik ödemesi için kullanılacaktır.</small>
                            </div>
                        </div>

                        <!-- Otomatik Yenileme -->
                        <div class="mb-4">
                            <div class="form-check">
                                <input asp-for="AutoRenew" class="form-check-input" type="checkbox" id="autoRenew">
                                <label class="form-check-label" for="autoRenew">
                                    <strong>Otomatik Yenileme</strong>
                                </label>
                            </div>
                            <small class="text-muted">
                                Üyeliğinizi otomatik olarak yenilemek için bu seçeneği işaretleyin.
                                İstediğiniz zaman iptal edebilirsiniz.
                            </small>
                        </div>

                        <!-- Toplam Tutar -->
                        <div class="mb-4">
                            <div class="total-card p-4 rounded-3 text-center">
                                <h4 class="mb-2 membership-total-title">Toplam Tutar</h4>
                                <h2 class="fw-bold membership-total-amount" id="totalAmount">₺3.000</h2>
                                <p class="mb-0 membership-total-period" id="membershipPeriod">1 Ay</p>
                            </div>
                        </div>

                        <!-- Sözleşmeler -->
                        <div class="mb-4">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="checkbox" id="terms" required>
                                <label class="form-check-label" for="terms">
                                    <a href="#" class="text-decoration-none">Üyelik Sözleşmesi</a>'ni okudum ve kabul ediyorum.
                                </label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="privacy" required>
                                <label class="form-check-label" for="privacy">
                                    <a href="#" class="text-decoration-none">Gizlilik Politikası</a>'nı okudum ve kabul ediyorum.
                                </label>
                            </div>
                        </div>
                    </div>

                    <!-- Kart Alt Kısmı - Ödeme Butonu -->
                    <div class="card-footer membership-card-footer text-center py-4">
                        <button type="submit" class="btn btn-lg px-5 py-3 membership-payment-button" id="paymentButton">
                            <i class="bi bi-credit-card me-2"></i>
                            <span id="buttonText">Ödemeyi Tamamla</span>
                        </button>
                        <p class="mt-2 mb-0 membership-security-text">
                            <i class="bi bi-shield-check me-1"></i>
                            256-bit SSL ile güvenli ödeme
                        </p>
                    </div>
                </form>
            </div>

            <!-- Geri Dön Butonu -->
            <div class="text-center mt-4">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-2"></i>Ana Sayfa'ya Dön
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Üyelik türü değiştiğinde fiyatı güncelle
        document.querySelectorAll('.membership-radio').forEach(radio => {
            radio.addEventListener('change', function() {
                updateTotal();
                updateSelectedCard();
            });
        });

        function updateTotal() {
            const selectedRadio = document.querySelector('.membership-radio:checked');
            const membershipType = parseInt(selectedRadio.value);
            let price = 3000;
            let period = "1 Ay";

            switch (membershipType) {
                case 1: // Monthly
                    price = 3000;
                    period = "1 Ay";
                    break;
                case 3: // Quarterly
                    price = 8000;
                    period = "3 Ay";
                    break;
                case 6: // SemiAnnual
                    price = 15000;
                    period = "6 Ay";
                    break;
                case 12: // Annual
                    price = 28000;
                    period = "1 Yıl";
                    break;
            }

            document.getElementById('totalAmount').textContent = '₺' + price.toLocaleString();
            document.getElementById('membershipPeriod').textContent = period;
        }

        function updateSelectedCard() {
            // Önceki seçili kartı temizle
            document.querySelectorAll('.membership-option .card').forEach(card => {
                card.classList.remove('border-primary', 'shadow');
            });

            // Yeni seçili kartı vurgula
            const selectedRadio = document.querySelector('.membership-radio:checked');
            const selectedOption = selectedRadio.closest('.membership-option');
            const selectedCard = selectedOption.querySelector('.card');

            selectedCard.classList.add('border-primary', 'shadow');
        }

        // Sayfa yüklendiğinde varsayılan seçimi vurgula
        document.addEventListener('DOMContentLoaded', function() {
            updateSelectedCard();
        });

        // Form submit olduğunda loading göster
        document.getElementById('membershipForm').addEventListener('submit', function(e) {
            const button = document.getElementById('paymentButton');
            const buttonText = document.getElementById('buttonText');

            button.disabled = true;
            buttonText.textContent = 'Ödeme İşleniyor...';

            // Loading spinner ekle
            button.innerHTML = `
                <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                <span id="buttonText">Ödeme İşleniyor...</span>
            `;
        });
    </script>
}


<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - KADİR FITNESS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FitnessCenter.styles.css" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <style>
        .navbar-contact-info {
            margin-left: 2rem;
            display: flex;
            gap: 1.5rem;
        }
        .contact-item {
            color: rgba(255, 255, 255, 0.8);
            font-size: 0.875rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
        .contact-item:hover {
            color: #fff;
        }
        .contact-item i {
            font-size: 1rem;
        }

        /* Admin Dropdown Professional Design */
        .admin-dropdown-toggle {
            background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
            color: #ffffff !important;
            border: 1px solid #404040;
            border-radius: 25px;
            padding: 8px 16px !important;
            margin: 0 10px;
            transition: all 0.3s ease;
            text-decoration: none;
            display: flex;
            align-items: center;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.85rem;
            position: relative;
        }

        .admin-dropdown-toggle:hover {
            background: linear-gradient(135deg, #3a3a3a 0%, #2a2a2a 100%);
            border-color: #555555;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            color: #ffffff !important;
        }

        .admin-dropdown-toggle:focus {
            box-shadow: 0 0 0 0.2rem rgba(64, 64, 64, 0.5);
        }

        .admin-text {
            background: linear-gradient(45deg, #007bff, #28a745, #ffc107, #dc3545);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .dropdown-arrow {
            font-size: 0.7rem;
            transition: transform 0.3s ease;
        }

        .nav-item.dropdown:hover .dropdown-arrow {
            transform: rotate(180deg);
        }

        .admin-dropdown-menu {
            background: linear-gradient(135deg, #2a2a2a 0%, #1e1e1e 100%);
            border: 1px solid #404040;
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.4);
            padding: 0;
            min-width: 320px;
            margin-top: 8px;
        }

        .admin-dropdown-menu::before {
            content: '';
            position: absolute;
            top: -8px;
            right: 20px;
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-bottom: 8px solid #404040;
        }

        .admin-dropdown-menu::after {
            content: '';
            position: absolute;
            top: -7px;
            right: 20px;
            width: 0;
            height: 0;
            border-left: 8px solid transparent;
            border-right: 8px solid transparent;
            border-bottom: 8px solid #2a2a2a;
        }

        .dropdown-header {
            background: linear-gradient(135deg, #333333 0%, #262626 100%);
            color: #ffffff;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            font-size: 0.8rem;
            padding: 12px 16px;
            margin: 0;
            border-bottom: 1px solid #404040;
        }

        .admin-menu-item {
            display: flex !important;
            align-items: center;
            padding: 12px 16px !important;
            color: #e0e0e0 !important;
            text-decoration: none;
            transition: all 0.3s ease;
            border-bottom: 1px solid #333333;
        }

        .admin-menu-item:last-child {
            border-bottom: none;
        }

        .admin-menu-item:hover {
            background: linear-gradient(135deg, #3a3a3a 0%, #2e2e2e 100%);
            color: #ffffff !important;
            transform: translateX(5px);
        }

        .menu-icon {
            background: linear-gradient(135deg, #4a4a4a 0%, #333333 100%);
            border-radius: 10px;
            width: 45px;
            height: 45px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            font-size: 1.2rem;
            margin-right: 12px;
            flex-shrink: 0;
            box-shadow: 0 3px 10px rgba(0,0,0,0.2);
        }

        .menu-content {
            flex: 1;
        }

        .menu-title {
            font-weight: 600;
            font-size: 0.95rem;
            color: #ffffff;
            margin-bottom: 2px;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .menu-description {
            font-size: 0.75rem;
            color: #a0a0a0;
            margin: 0;
            font-weight: 400;
        }

        /* Custom scrollbar for dropdown */
        .admin-dropdown-menu::-webkit-scrollbar {
            width: 6px;
        }

        .admin-dropdown-menu::-webkit-scrollbar-track {
            background: #1e1e1e;
        }

        .admin-dropdown-menu::-webkit-scrollbar-thumb {
            background: #404040;
            border-radius: 3px;
        }

        .admin-dropdown-menu::-webkit-scrollbar-thumb:hover {
            background: #555555;
        }

        /* Responsive adjustments */
        @@media (max-width: 768px) {
            .admin-dropdown-toggle {
                padding: 6px 12px !important;
                margin: 0 5px;
                font-size: 0.75rem;
            }

            .admin-dropdown-menu {
                min-width: 280px;
                margin-top: 5px;
            }

            .menu-icon {
                width: 40px;
                height: 40px;
                font-size: 1.1rem;
            }

            .menu-title {
                font-size: 0.9rem;
            }

            .menu-description {
                font-size: 0.7rem;
            }
        }

        /* Professional Dark Theme for User Menu */
        .navbar-nav .nav-link {
            background: transparent;
            border-radius: 8px;
            margin: 0 4px;
            transition: all 0.3s ease;
            position: relative;
            color: #e0e0e0 !important;
            font-weight: 500;
        }

        .navbar-nav .nav-link::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 50%;
            transform: translateX(-50%);
            width: 0;
            height: 2px;
            background: linear-gradient(90deg, #007bff, #00d4ff);
            transition: width 0.3s ease;
        }

        .navbar-nav .nav-link:hover {
            background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
            color: #ffffff !important;
            transform: translateY(-1px);
        }

        .navbar-nav .nav-link:hover::before {
            width: 80%;
        }

        /* User Dropdown Professional Design */
        .navbar-actions .user-dropdown-toggle {
            background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%) !important;
            border: 1px solid #404040 !important;
            color: #ffffff !important;
            border-radius: 20px;
            padding: 8px 16px;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .navbar-actions .user-dropdown-toggle:hover {
            background: linear-gradient(135deg, #3a3a3a 0%, #2a2a2a 100%) !important;
            border-color: #ffc107 !important;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(255, 193, 7, 0.3);
        }

        .navbar-actions .user-dropdown-menu {
            background: linear-gradient(135deg, #2a2a2a 0%, #1e1e1e 100%) !important;
            border: 1px solid #555555 !important;
            border-radius: 12px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
            padding: 8px 0;
            min-width: 220px;
            margin-top: 8px;
        }

        .navbar-actions .user-dropdown-item {
            color: #e0d4a0 !important;
            padding: 12px 20px;
            transition: all 0.3s ease;
            border: none;
            background: transparent;
            width: 100%;
            text-align: left;
            font-weight: 500;
        }

        .navbar-actions .user-dropdown-item i {
            color: #ffc107 !important;
            width: 20px;
        }

        .navbar-actions .user-dropdown-item:hover {
            background: linear-gradient(135deg, #3a3a3a 0%, #2e2e2e 100%) !important;
            color: #ffd700 !important;
            transform: translateX(5px);
        }

        .navbar-actions .user-dropdown-item.user-dropdown-logout {
            color: #ff6b6b !important;
        }

        .navbar-actions .user-dropdown-item.user-dropdown-logout:hover {
            background: linear-gradient(135deg, #3a1a1a 0%, #2a0f0f 100%) !important;
            color: #ff8787 !important;
        }

        .navbar-actions .user-dropdown-item.user-dropdown-logout i {
            color: #ff6b6b !important;
        }

        .navbar-actions .user-dropdown-divider {
            border-color: #555555 !important;
            margin: 8px 0;
            opacity: 0.5;
        }

        /* Login Button Professional Design */
        .navbar-actions .btn-outline-light {
            background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
            border: 1px solid #404040;
            color: #ffffff !important;
            border-radius: 20px;
            padding: 8px 20px;
            transition: all 0.3s ease;
            font-weight: 500;
        }

        .navbar-actions .btn-outline-light:hover {
            background: linear-gradient(135deg, #3a3a3a 0%, #2a2a2a 100%);
            border-color: #555555;
            transform: translateY(-1px);
            box-shadow: 0 4px 15px rgba(0,0,0,0.3);
            color: #ffffff !important;
        }

        /* Navbar Brand Enhancement */
        .navbar-brand {
            transition: all 0.3s ease;
        }

        .navbar-brand:hover {
            transform: scale(1.05);
        }

        .brand-name {
            background: linear-gradient(135deg, #ffffff 0%, #b0b0b0 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        /* Hamburger Menu Professional Design */
        .hamburger-menu {
            border: 1px solid #404040;
            border-radius: 8px;
            padding: 8px;
            background: linear-gradient(135deg, #2c2c2c 0%, #1a1a1a 100%);
        }

        .hamburger-menu span {
            display: block;
            width: 25px;
            height: 3px;
            background: #ffffff;
            margin: 4px 0;
            transition: all 0.3s ease;
            border-radius: 2px;
        }

        .hamburger-menu:hover {
            background: linear-gradient(135deg, #3a3a3a 0%, #2a2a2a 100%);
            border-color: #555555;
        }
    </style>
</head>
<body class="@(User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") ? "user-authenticated-body" : "")">
    <div class="top-header">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <!-- Sosyal medya linkleri kaldırıldı -->
                </div>
                <div class="col-md-6 text-end">
                    <!-- İletişim bilgileri navbar'a taşındı -->
                </div>
            </div>
        </div>
    </div>

    <nav class="navbar navbar-expand-lg navbar-dark main-navbar">
        <div class="container-fluid">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-name">KADIR</span>
                <span class="brand-subtitle">FITNESS</span>
            </a>

            <!-- İletişim Bilgileri - Sol Üst Köşe -->
            <div class="navbar-contact-info d-none d-lg-flex">
                <span class="contact-item"><i class="bi bi-clock"></i> Açık: Her gün 05:00 - 22:00</span>
            </div>

            <button class="navbar-toggler hamburger-menu" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span></span>
                <span></span>
                <span></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (!User.IsInRole("Admin"))
                    {
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Fitness</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Services">Hizmetler</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Trainers" asp-action="List">Antrenörler</a>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Membership" asp-action="Index">Üyelik</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Locations" asp-action="Index">Lokasyon</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Ai" asp-action="Index">AI Öneriler</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Appointments" asp-action="Index">Randevularım</a>
                            </li>
                        }
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link admin-dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="bi bi-shield-check-fill me-2"></i>
                                <span class="admin-text">ADMIN PANELİ</span>
                                <i class="bi bi-chevron-down ms-1 dropdown-arrow"></i>
                            </a>
                            <ul class="dropdown-menu admin-dropdown-menu shadow-xl">
                                <li class="dropdown-header">
                                    <i class="bi bi-gear-fill me-2"></i>
                                    Yönetim Modülleri
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <a class="dropdown-item admin-menu-item" asp-controller="Admin" asp-action="Appointments">
                                        <div class="menu-icon">
                                            <i class="bi bi-calendar-check-fill"></i>
                                        </div>
                                        <div class="menu-content">
                                            <div class="menu-title">Randevu Yönetimi</div>
                                            <div class="menu-description">Tüm randevuları yönet</div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item admin-menu-item" asp-controller="Admin" asp-action="Trainers">
                                        <div class="menu-icon">
                                            <i class="bi bi-person-badge-fill"></i>
                                        </div>
                                        <div class="menu-content">
                                            <div class="menu-title">Antrenör Yönetimi</div>
                                            <div class="menu-description">Antrenörleri yönet</div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item admin-menu-item" asp-controller="Admin" asp-action="Services">
                                        <div class="menu-icon">
                                            <i class="bi bi-tools-fill"></i>
                                        </div>
                                        <div class="menu-content">
                                            <div class="menu-title">Hizmet Yönetimi</div>
                                            <div class="menu-description">Hizmetleri yönet</div>
                                        </div>
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item admin-menu-item" asp-controller="Admin" asp-action="Memberships">
                                        <div class="menu-icon">
                                            <i class="bi bi-card-checklist-fill"></i>
                                        </div>
                                        <div class="menu-content">
                                            <div class="menu-title">Üyelik Yönetimi</div>
                                            <div class="menu-description">Üyelikleri yönet</div>
                                        </div>
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
                <div class="navbar-actions ms-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <div class="dropdown">
                            <a class="btn btn-outline-light btn-sm dropdown-toggle user-dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end user-dropdown-menu">
                                <li><a class="dropdown-item user-dropdown-item" href="#"><i class="bi bi-person me-2"></i>Profil</a></li>
                                <li><hr class="dropdown-divider user-dropdown-divider"></li>
                                <li>
                                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                        <button type="submit" class="dropdown-item user-dropdown-item user-dropdown-logout"><i class="bi bi-box-arrow-right me-2"></i>Çıkış Yap</button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-outline-light btn-sm me-2">Kayıt Ol</a>
                        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-sm">Giriş</a>
                    }
                </div>
            </div>
        </div>
    </nav>

    <main class="@(User.Identity?.IsAuthenticated == true && !User.IsInRole("Admin") ? "user-authenticated" : "")" style="padding-top: 0;">
        @RenderBody()
    </main>

    <footer class="footer-dark">
        <div class="container py-5">
            <div class="row">
                <div class="col-md-3 mb-4">
                    <h5 class="footer-brand">KADIR FITNESS®</h5>
                    <p class="footer-text">Türkiye'nin ilk tam ölçekli yapay zeka destekli spor salonu. Teknolojiyi kullanarak kişiselleştirilmiş fitness ve sağlığı uygun fiyatlı hale getiriyoruz.</p>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="footer-heading">KADIR FITNESS®</h6>
                    <ul class="footer-links">
                        <li><a href="#">Fitness</a></li>
                        <li><a asp-controller="Trainers" asp-action="List">Antrenörler</a></li>
                        <li><a asp-controller="Membership" asp-action="Index">Üyelik</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="footer-heading">Bilgi</h6>
                    <ul class="footer-links">
                        <li><a asp-controller="Account" asp-action="Register">Kayıt Ol</a></li>
                        <li><a asp-controller="Locations" asp-action="Index">Lokasyon</a></li>
                        <li><a href="#">Üyelik</a></li>
                        <li><a href="#">Faturalama ve İptal</a></li>
                        <li><a href="#">Gizlilik Politikası</a></li>
                        <li><a href="#">Kullanım Şartları</a></li>
                    </ul>
                </div>
                <div class="col-md-3 mb-4">
                    <h6 class="footer-heading">İletişim</h6>
                    <p class="footer-text">
                        <strong>Adres:</strong> İstanbul, Türkiye<br>
                        <strong>Telefon:</strong> (555) 123-4567<br>
                        <strong>Email:</strong> info@fitnesscenter.com
                    </p>
                </div>
            </div>
            <hr class="footer-divider">
            <div class="text-center">
                <p class="footer-copyright">&copy; 2025 KADIR FITNESS. Tüm hakları saklıdır.</p>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
@{
    ViewData["Title"] = "Yapay Zeka Destekli Öneriler";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary mb-3">
            <i class="bi bi-robot me-3"></i>
            Yapay Zeka Destekli Öneriler
        </h1>
        <p class="lead text-muted">
            AI teknolojisi ile kişiselleştirilmiş fitness ve beslenme önerileri alın
        </p>

    </div>

    <!-- Fotoğraf Analizi Bölümü -->
    <div class="row mb-5">
        <div class="col-12">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-gradient-primary text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-camera me-2"></i>
                        Fotoğraf Analizi & AI Önerileri
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-12 mb-4">
                            <h6 class="text-primary mb-3">
                                <i class="bi bi-upload me-2"></i>
                                Fotoğraf Yükle
                            </h6>
                            <form id="photoForm" enctype="multipart/form-data">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <input type="file" id="photoInput" class="form-control" accept="image/*" required />
                                            <small class="text-muted">JPG, PNG veya GIF formatında bir fotoğraf yükleyin</small>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label class="form-label">Analiz Türü</label>
                                            <select id="analysisType" class="form-select">
                                                <option value="body_analysis">Vücut Analizi</option>
                                                <option value="posture_analysis">Duruş Analizi</option>
                                                <option value="progress_tracking">İlerleme Takibi</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>
                                <button type="submit" class="btn btn-success">
                                    <i class="bi bi-search me-1"></i>Analiz Et
                                </button>
                            </form>
                            <div id="photoResult" class="mt-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-activity me-2"></i>
                        Egzersiz Önerileri
                    </h5>
                </div>
                <div class="card-body">
                    <form id="exerciseForm">
                        <div class="mb-3">
                            <label class="form-label">Boy (cm)</label>
                            <input type="number" id="height" class="form-control" placeholder="Örn: 175" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Kilo (kg)</label>
                            <input type="number" id="weight" class="form-control" placeholder="Örn: 70" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Vücut Tipi</label>
                            <select id="bodyType" class="form-select">
                                <option value="">Seçiniz</option>
                                <option value="Ektomorf">Ektomorf (İnce)</option>
                                <option value="Mezomorf">Mezomorf (Atletik)</option>
                                <option value="Endomorf">Endomorf (Yapılı)</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Hedef</label>
                            <select id="goal" class="form-select">
                                <option value="">Seçiniz</option>
                                <option value="Kilo Verme">Kilo Verme</option>
                                <option value="Kilo Alma">Kilo Alma</option>
                                <option value="Kas Geliştirme">Kas Geliştirme</option>
                                <option value="Güç Artırma">Güç Artırma</option>
                                <option value="Genel Fitness">Genel Fitness</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Fitness Seviyesi</label>
                            <select id="fitnessLevel" class="form-select">
                                <option value="">Seçiniz</option>
                                <option value="Başlangıç">Başlangıç</option>
                                <option value="Orta">Orta</option>
                                <option value="İleri">İleri</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Yaş (opsiyonel)</label>
                            <input type="number" id="age" class="form-control" placeholder="Örn: 25" min="10" max="100" />
                        </div>
                        <button type="submit" class="btn btn-primary">Öneri Al</button>
                    </form>
                    <div id="exerciseResult" class="mt-3"></div>
                </div>
            </div>
        </div>

        <div class="col-md-6 mb-4">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-apple me-2"></i>
                        Diyet Planı Önerileri
                    </h5>
                </div>
                <div class="card-body">
                    <form id="dietForm">
                        <div class="mb-3">
                            <label class="form-label">Boy (cm)</label>
                            <input type="number" id="dietHeight" class="form-control" placeholder="Örn: 175" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Kilo (kg)</label>
                            <input type="number" id="dietWeight" class="form-control" placeholder="Örn: 70" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Hedef</label>
                            <select id="dietGoal" class="form-select">
                                <option value="">Seçiniz</option>
                                <option value="Kilo Verme">Kilo Verme</option>
                                <option value="Kilo Alma">Kilo Alma</option>
                                <option value="Kas Geliştirme">Kas Geliştirme</option>
                                <option value="Sağlıklı Beslenme">Sağlıklı Beslenme</option>
                            </select>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Yaş (opsiyonel)</label>
                            <input type="number" id="dietAge" class="form-control" placeholder="Örn: 25" min="10" max="100" />
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Diyet Kısıtlamaları</label>
                            <input type="text" id="dietaryRestrictions" class="form-control" placeholder="Örn: Vejetaryen, Glutensiz" />
                        </div>
                        <button type="submit" class="btn btn-primary">Diyet Planı Al</button>
                    </form>
                    <div id="dietResult" class="mt-3"></div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Fotoğraf analizi
        $('#photoForm').submit(function(e) {
            e.preventDefault();

            var fileInput = $('#photoInput')[0];
            if (!fileInput.files[0]) {
                $('#photoResult').html('<div class="alert alert-danger">Lütfen bir fotoğraf seçin.</div>');
                return;
            }

            var formData = new FormData();
            formData.append('photo', fileInput.files[0]);
            formData.append('analysisType', $('#analysisType').val());

            $('#photoResult').html('<div class="alert alert-info">Fotoğraf analiz ediliyor...</div>');

            $.ajax({
                url: '/Ai/AnalyzePhoto',
                method: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    $('#photoResult').html('<div class="alert alert-success"><h6>Fotoğraf Analizi:</h6><pre style="white-space: pre-wrap;">' + response.analysis + '</pre></div>');
                },
                error: function(xhr) {
                    var error = xhr.responseJSON?.error || 'Fotoğraf analizi sırasında hata oluştu';
                    $('#photoResult').html('<div class="alert alert-danger">' + error + '</div>');
                }
            });
        });


        // Egzersiz önerileri
        $('#exerciseForm').submit(function(e) {
            e.preventDefault();
            var data = {
                height: parseInt($('#height').val()) || 170,
                weight: parseInt($('#weight').val()) || 70,
                bodyType: $('#bodyType').val() || "Mezomorf",
                goal: $('#goal').val() || "Genel Fitness",
                fitnessLevel: $('#fitnessLevel').val() || "Orta",
                age: parseInt($('#age').val()) || 25
            };

            $('#exerciseResult').html('<div class="alert alert-info">AI egzersiz planı hazırlıyor...</div>');

            $.ajax({
                url: '/Ai/GetExerciseRecommendation',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response) {
                    $('#exerciseResult').html('<div class="alert alert-success"><h6>Egzersiz Önerileri:</h6><pre style="white-space: pre-wrap;">' + response.recommendation + '</pre></div>');
                },
                error: function(xhr) {
                    var error = xhr.responseJSON?.error || 'Egzersiz önerisi alınırken hata oluştu';
                    $('#exerciseResult').html('<div class="alert alert-danger">' + error + '</div>');
                }
            });
        });

        // Diyet planı
        $('#dietForm').submit(function(e) {
            e.preventDefault();
            var data = {
                height: parseInt($('#dietHeight').val()) || 170,
                weight: parseInt($('#dietWeight').val()) || 70,
                goal: $('#dietGoal').val() || "Sağlıklı Beslenme",
                age: parseInt($('#dietAge').val()) || 25,
                dietaryRestrictions: $('#dietaryRestrictions').val() || "Yok"
            };

            $('#dietResult').html('<div class="alert alert-info">AI diyet planı hazırlıyor...</div>');

            $.ajax({
                url: '/Ai/GetDietPlan',
                method: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(response) {
                    $('#dietResult').html('<div class="alert alert-success"><h6>Diyet Planı:</h6><pre style="white-space: pre-wrap;">' + response.dietPlan + '</pre></div>');
                },
                error: function(xhr) {
                    var error = xhr.responseJSON?.error || 'Diyet planı alınırken hata oluştu';
                    $('#dietResult').html('<div class="alert alert-danger">' + error + '</div>');
                }
            });
        });
    </script>
}


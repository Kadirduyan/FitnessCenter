@model IEnumerable<FitnessCenter.Models.Trainer>
@{
    ViewData["Title"] = "Uzman Kadromuz";
}

<div class="container my-5">
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold">Profesyonel Antrenörlerimiz</h1>
        <p class="lead text-muted">Hedeflerinize ulaşmanız için alanında uzman eğitmenlerimiz yanınızda.</p>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            // HER ANTRENÖR İÇİN BENZERSİZ FİTNESSÇI MODEL FOTOĞRAFLARI
            string imgUrl = "";

            // Her antrenör için GERÇEK fitness koçu fotoğrafları (Google'dan)
            switch (item.FirstName)
            {
                // ERKEK ANTRENÖRLER - Erkek fitness koçu fotoğrafları
                case "Ahmet":
                    imgUrl = "https://c.superprof.com/i/m/32540448/600/20240827210733/32540448.webp"; // Gerçek erkek koç 1
                    break;
                case "Mehmet":
                    imgUrl = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ5dVF5ccEAYr5RZLpMXxyp6xCzybwTuF_e4g&s"; // Mehmet Kaya
                    break;
                case "Burak":
                    imgUrl = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcStSJ2c_4nm0fuA8Q7RMHE9yqo8naKLSiYBLA&s"; // Burak Demir
                    break;
                case "Can":
                    imgUrl = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTnk7HMwsjezVPG6qJpzkB8fS1N472Pgs7bdw&s"; // Can Şahin
                    break;
                case "Zafer":
                    imgUrl = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTCfitLZii4Vi3GtYgubK1csGdK-fm2xynoFA&s"; // Zafer Koç
                    break;
                case "Aras":
                    imgUrl = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTk7K1xKtK-7znRZPm1KF-Km0bd0VTuINzISQ&s"; // Aras Tekin
                    break;
                case "Rüzgar":
                    imgUrl = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSrFrDiz8JdfcvHw1fCA2dkydO-9z0sO8kKjg&s"; // Rüzgar Özdemir
                    break;

                // KADIN ANTRENÖRLER - Kadın fitness koçları fotoğrafları
                case "Merve":
                    imgUrl = "https://www.ozeldersalani.com/images/teachers/1740636903.jpg"; // Merve Öztürk
                    break;
                case "Sahra":
                    imgUrl = "https://foto.haberler.com/haber/2020/09/25/alica-schmidt-borussia-dortmund-un-yeni-fitness-13627211_3187_m.jpg"; // Sahra Çelik
                    break;
                case "Eda":
                    imgUrl = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcT0B8ZEcrGxMxuS1fwt5UXqIxK-g7mEiWMdTg&s"; // Eda Yıldız
                    break;
                case "Selin":
                    imgUrl = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcQ-QPj9vg-hfYp7gqAKnYSUWto_2rLbme0OWg&s"; // Selin Aydın
                    break;
                case "Gamze":
                    imgUrl = "https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTV3mTudTNmRSYTcBbdT9k7mpIUHCRwazBEMA&s"; // Gamze Akın
                    break;

                default:
                    // Varsayılan fotoğraf - fitness temalı
                    imgUrl = "https://c.superprof.com/i/m/32540448/600/20240827210733/32540448.webp";
                    break;
            }

            <div class="col-md-4 mb-4">
                <div class="card h-100 shadow border-0 hover-effect">
                    <div class="position-relative text-center pt-4 pb-2 bg-light">
                        <img src="@imgUrl" class="rounded-circle shadow-sm" style="width: 140px; height: 140px; object-fit: cover; border: 4px solid white;" alt="@item.FirstName">
                        <div class="mt-2">
                             <span class="badge bg-primary">@item.Specializations</span>
                        </div>
                    </div>
                    
                    <div class="card-body text-center">
                        <h4 class="card-title fw-bold mb-1">@item.FirstName @item.LastName</h4>
                        <p class="text-muted small mb-3">
                            <i class="bi bi-geo-alt-fill text-danger"></i> @item.FitnessCenter?.Name
                        </p>
                        
                        <p class="card-text text-muted">
                            @(item.Description?.Length > 90 ? item.Description.Substring(0, 90) + "..." : item.Description)
                        </p>
                        
                        <div class="mb-3">
                            @foreach(var service in item.Services.Take(3))
                            {
                                <span class="badge bg-light text-dark border me-1">@service.Name</span>
                            }
                        </div>
                    </div>
                    
                    <div class="card-footer bg-white border-0 pb-4 px-4">
                        <a asp-controller="Appointments" asp-action="Create" asp-route-trainerId="@item.Id" class="btn btn-warning w-100 fw-bold py-2">
                            <i class="bi bi-calendar-check me-2"></i>Randevu Al
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .hover-effect { transition: transform 0.3s ease; }
    .hover-effect:hover { transform: translateY(-5px); }
</style>
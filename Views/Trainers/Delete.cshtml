@model FitnessCenter.Models.Trainer

@{
    ViewData["Title"] = "Antrenör Sil";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-triangle me-2"></i>Antrenörü Sil
                    </h5>
                </div>
                <div class="card-body">
                    <p class="mb-3">Bu antrenörü silmek istediğinizden emin misiniz?</p>

                    <dl class="row mb-4">
                        <dt class="col-sm-4">Ad Soyad</dt>
                        <dd class="col-sm-8">@Model.FullName</dd>

                        <dt class="col-sm-4">Spor Salonu</dt>
                        <dd class="col-sm-8">@Model.FitnessCenter?.Name</dd>

                        <dt class="col-sm-4">Uzmanlıklar</dt>
                        <dd class="col-sm-8">@Model.Specializations</dd>
                    </dl>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-1"></i>Evet, Sil
                            </button>
                            <a asp-controller="Admin" asp-action="Trainers" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Vazgeç
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>



@model FitnessCenter.Models.FitnessCenterModel
@{
    ViewData["Title"] = "Spor Salonu Sil";
}

<div class="container my-5">
    <div class="card shadow-custom">
        <div class="card-body p-5">
            <h1 class="text-danger mb-4">Spor Salonunu Silmek İstediğinize Emin misiniz?</h1>
            
            <div class="alert alert-warning">
                <strong>Dikkat!</strong> Bu işlem geri alınamaz. Bu spor salonuna ait tüm hizmetler, antrenörler ve randevular silinecektir.
            </div>

            <div class="row mt-4">
                <div class="col-md-6">
                    <h5>Spor Salonu Bilgileri</h5>
                    <table class="table table-borderless">
                        <tr>
                            <th>Ad:</th>
                            <td>@Model.Name</td>
                        </tr>
                        <tr>
                            <th>Adres:</th>
                            <td>@(Model.Address ?? "Belirtilmemiş")</td>
                        </tr>
                        <tr>
                            <th>Çalışma Saatleri:</th>
                            <td>@Model.OpenTime.ToString(@"hh\:mm") - @Model.CloseTime.ToString(@"hh\:mm")</td>
                        </tr>
                        <tr>
                            <th>Hizmet Sayısı:</th>
                            <td>@Model.Services.Count</td>
                        </tr>
                        <tr>
                            <th>Antrenör Sayısı:</th>
                            <td>@Model.Trainers.Count</td>
                        </tr>
                    </table>
                </div>
            </div>

            <form asp-action="Delete" method="post" class="mt-4">
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">Sil</button>
                <a asp-action="Index" class="btn btn-secondary">İptal</a>
            </form>
        </div>
    </div>
</div>


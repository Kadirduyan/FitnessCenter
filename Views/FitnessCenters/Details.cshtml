@model FitnessCenter.Models.Trainer
@{
    ViewData["Title"] = "Antrenör Detayı";
}

<div class="container my-5">
    <div class="row">
        <div class="col-md-4">
            <div class="card shadow-sm">
                <div class="card-body text-center">
                    <h3 class="card-title">@Model.FirstName @Model.LastName</h3>
                    <p class="text-muted">@Model.Specializations</p>
                    <hr />
                    <p><strong>Salon:</strong> @Model.FitnessCenter?.Name</p>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning w-100 mb-2">Düzenle</a>
                    <a asp-action="AddAvailability" asp-route-id="@Model.Id" class="btn btn-primary w-100">Çalışma Saati Ekle</a>
                </div>
            </div>
        </div>

        <div class="col-md-8">
            <div class="card mb-4">
                <div class="card-header bg-info text-white">Verebildiği Hizmetler</div>
                <div class="card-body">
                    @if (Model.Services.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var s in Model.Services)
                            {
                                <span class="badge bg-secondary fs-6">@s.Name (@s.ServiceType)</span>
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted">Henüz hizmet tanımlanmamış.</p>
                    }
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-success text-white">Çalışma Saatleri (Müsaitlik)</div>
                <div class="card-body">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Gün</th>
                                <th>Saat Aralığı</th>
                                <th>İşlem</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.Availabilities)
                            {
                                <tr>
                                    <td>@item.DayOfWeek</td>
                                    <td>@item.StartTime.ToString(@"hh\:mm") - @item.EndTime.ToString(@"hh\:mm")</td>
                                    <td>
                                        <form asp-action="DeleteAvailability" method="post" style="display:inline;">
                                            <input type="hidden" name="id" value="@item.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
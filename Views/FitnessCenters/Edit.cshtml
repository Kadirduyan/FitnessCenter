@model FitnessCenter.Models.Trainer
@{
    ViewData["Title"] = "Antrenör Düzenle";
    // Eğer ViewBag boş gelirse hata vermemesi için "?? new List..." ekledik
    var services = ViewBag.Services as List<FitnessCenter.Models.Service> ?? new List<FitnessCenter.Models.Service>();
}

<div class="container my-5">
    <h1>Antrenör Düzenle</h1>
    <hr />
    <form asp-action="Edit">
        <input type="hidden" asp-for="Id" />
        
        <div class="row">
            <div class="col-md-8">
                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="FitnessCenterId" class="form-label"></label>
                    <select asp-for="FitnessCenterId" class="form-select" asp-items="ViewBag.FitnessCenterId"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="Specializations" class="form-label"></label>
                    <input asp-for="Specializations" class="form-control" />
                    <span asp-validation-for="Specializations" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <input class="form-check-input" asp-for="IsActive" /> 
                    <label class="form-check-label" asp-for="IsActive"></label>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Verebileceği Hizmetler</label>
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                @if (services.Any())
                                {
                                    foreach (var service in services)
                                    {
                                        // Model.Services null gelirse hata vermesin diye kontrol ekledik
                                        var isChecked = (Model.Services != null && Model.Services.Any(s => s.Id == service.Id)) ? "checked" : "";
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="selectedServices" value="@service.Id" id="service_@service.Id" @isChecked>
                                                <label class="form-check-label" for="service_@service.Id">
                                                    @service.Name
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                                else
                                {
                                    <div class="alert alert-warning">Sistemde kayıtlı hizmet bulunamadı.</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-warning">Güncelle</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </div>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
@model IEnumerable<FitnessCenter.Models.FitnessCenterModel>
@{
    ViewData["Title"] = "Spor Salonları";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Spor Salonları</h1>
        <a asp-action="Create" class="btn btn-primary">Yeni Spor Salonu Ekle</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Ad</th>
                    <th>Açıklama</th>
                    <th>Adres</th>
                    <th>Telefon</th>
                    <th>Çalışma Saatleri</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Name</td>
                        <td>@(item.Description?.Length > 50 ? item.Description.Substring(0, 50) + "..." : item.Description)</td>
                        <td>@item.Address</td>
                        <td>@item.Phone</td>
                        <td>@item.OpenTime.ToString(@"hh\:mm") - @item.CloseTime.ToString(@"hh\:mm")</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detay</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


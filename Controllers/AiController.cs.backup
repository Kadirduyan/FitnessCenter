using FitnessCenter.Data;
using FitnessCenter.Models;
using FitnessCenter.Services;
using Microsoft.AspNetCore.Authorization;
using Microsoft.AspNetCore.Identity;
using Microsoft.AspNetCore.Mvc;
using System.Text;
using System.Text.Json;

namespace FitnessCenter.Controllers;
    public class AiController : Controller
    {
        private readonly ApplicationDbContext _context;
        private readonly UserManager<ApplicationUser> _userManager;
        private readonly IConfiguration _configuration;
        private readonly HttpClient _httpClient;
        private readonly GeminiService _geminiService;

        public AiController(
            ApplicationDbContext context,
            UserManager<ApplicationUser> userManager,
            IConfiguration configuration,
            IHttpClientFactory httpClientFactory,
            GeminiService geminiService)
        {
            _context = context;
            _userManager = userManager;
            _configuration = configuration;
            _httpClient = httpClientFactory.CreateClient();
            _geminiService = geminiService;
        }

        public IActionResult Index()
        {
            return View();
        }

        [HttpGet]
        public IActionResult Test()
        {
            return Json(new { status = "API çalışıyor", timestamp = DateTime.Now });
        }

        [HttpPost]
        public async Task<IActionResult> GetExerciseRecommendation([FromBody] ExerciseRecommendationRequest request, string aiProvider = "gemini")
        {
            try
            {

                // OpenAI API key from configuration
                var apiKey = _configuration["OpenAI:ApiKey"];
                if (string.IsNullOrEmpty(apiKey))
                {
                    return BadRequest(new { error = "OpenAI API anahtarı yapılandırılmamış. Lütfen appsettings.json dosyasına 'OpenAI:ApiKey' ekleyin." });
                }

                // Build prompt based on user input
                var prompt = BuildExercisePrompt(request, user);

                string response;
                if (aiProvider == "gemini")
                {
                    // Gemini API kullan
                    response = await _geminiService.GenerateTextResponse(prompt);
                }
                else
                {
                    // OpenAI API kullan
                    var openAiKey = _configuration["OpenAI:ApiKey"];
                    if (string.IsNullOrEmpty(openAiKey))
                    {
                        return BadRequest(new { error = "OpenAI API anahtarı yapılandırılmamış." });
                    }
                    response = await CallOpenAI(openAiKey, prompt);
                }

                return Ok(new { recommendation = response });
            }
            catch (Exception ex)
            {
                // OpenAI API hatası için kullanıcı dostu mesaj
                if (ex.Message.Contains("401") || ex.Message.Contains("Unauthorized"))
                {
                    return BadRequest(new { error = "OpenAI API anahtarı geçersiz veya eksik. Lütfen geçerli bir API anahtarı kullanın. OpenAI hesabınızdan yeni bir anahtar oluşturabilirsiniz." });
                }
                return StatusCode(500, new { error = $"Bir hata oluştu: {ex.Message}" });
            }
        }

        [HttpPost]
        public async Task<IActionResult> GetDietPlan([FromBody] DietPlanRequest request, string aiProvider = "gemini")
        {
            try
            {

                var apiKey = _configuration["OpenAI:ApiKey"];
                if (string.IsNullOrEmpty(apiKey))
                {
                    return BadRequest(new { error = "OpenAI API anahtarı yapılandırılmamış." });
                }

                var prompt = BuildDietPrompt(request, user);

                string response;
                if (aiProvider == "gemini")
                {
                    // Gemini API kullan
                    response = await _geminiService.GenerateTextResponse(prompt);
                }
                else
                {
                    // OpenAI API kullan
                    var openAiKey = _configuration["OpenAI:ApiKey"];
                    if (string.IsNullOrEmpty(openAiKey))
                    {
                        return BadRequest(new { error = "OpenAI API anahtarı yapılandırılmamış." });
                    }
                    response = await CallOpenAI(openAiKey, prompt);
                }

                return Ok(new { dietPlan = response });
            }
            catch (Exception ex)
            {
                // OpenAI API hatası için kullanıcı dostu mesaj
                if (ex.Message.Contains("401") || ex.Message.Contains("Unauthorized"))
                {
                    return BadRequest(new { error = "OpenAI API anahtarı geçersiz veya eksik. Lütfen geçerli bir API anahtarı kullanın. OpenAI hesabınızdan yeni bir anahtar oluşturabilirsiniz." });
                }
                return StatusCode(500, new { error = $"Bir hata oluştu: {ex.Message}" });
            }
        }

        [HttpPost]
        public async Task<IActionResult> AnalyzePhoto(IFormFile photo, string analysisType = "body_analysis", string aiProvider = "gemini")
        {
            try
            {

                if (photo == null || photo.Length == 0)
                {
                    return BadRequest(new { error = "Lütfen bir fotoğraf yükleyin." });
                }

                // Fotoğrafı base64'e çevir
                string base64Image;
                using (var memoryStream = new MemoryStream())
                {
                    await photo.CopyToAsync(memoryStream);
                    var imageBytes = memoryStream.ToArray();
                    base64Image = Convert.ToBase64String(imageBytes);
                }

                var apiKey = _configuration["OpenAI:ApiKey"];
                if (string.IsNullOrEmpty(apiKey))
                {
                    return BadRequest(new { error = "OpenAI API anahtarı yapılandırılmamış." });
                }

                var prompt = BuildPhotoAnalysisPrompt(analysisType);

                string response;
                if (aiProvider == "gemini")
                {
                    // Gemini API ile fotoğraf analizi
                    response = await _geminiService.AnalyzeImage(base64Image, prompt);
                }
                else
                {
                    // OpenAI API ile fotoğraf analizi
                    var openAiKey = _configuration["OpenAI:ApiKey"];
                    if (string.IsNullOrEmpty(openAiKey))
                    {
                        return BadRequest(new { error = "OpenAI API anahtarı yapılandırılmamış." });
                    }
                    response = await CallOpenAIWithImage(openAiKey, prompt, base64Image);
                }

                return Ok(new { analysis = response });
            }
            catch (Exception ex)
            {
                // OpenAI API hatası için kullanıcı dostu mesaj
                if (ex.Message.Contains("401") || ex.Message.Contains("Unauthorized"))
                {
                    return BadRequest(new { error = "OpenAI API anahtarı geçersiz veya eksik. Lütfen geçerli bir API anahtarı kullanın. OpenAI hesabınızdan yeni bir anahtar oluşturabilirsiniz." });
                }
                return StatusCode(500, new { error = $"Fotoğraf analizi sırasında hata oluştu: {ex.Message}" });
            }
        }


        private string BuildPhotoAnalysisPrompt(string analysisType)
        {
            switch (analysisType)
            {
                case "body_analysis":
                    return "Bu kişinin vücut tipini, fitness seviyesini ve potansiyel gelişim alanlarını analiz et. Vücut kompozisyonu, duruş ve genel kondisyon hakkında detaylı geri bildirim ver. Türkçe yanıt ver.";
                case "posture_analysis":
                    return "Bu kişinin duruşunu analiz et. Sırt, omuzlar, kalça hizalama ve postür problemleri hakkında öneriler ver. Türkçe yanıt ver.";
                case "progress_tracking":
                    return "Bu kişinin fiziksel ilerlemesini değerlendir. Kas gelişimi, yağ oranı değişimi ve genel gelişim hakkında yorum yap. Türkçe yanıt ver.";
                default:
                    return "Bu fotoğrafı fitness açısından analiz et ve öneriler ver. Türkçe yanıt ver.";
            }
        }


        private async Task<string> CallOpenAIWithImage(string apiKey, string prompt, string base64Image)
        {
            var requestBody = new
            {
                model = "gpt-4-vision-preview",
                messages = new[]
                {
                    new
                    {
                        role = "user",
                        content = new object[]
                        {
                            new { type = "text", text = prompt },
                            new
                            {
                                type = "image_url",
                                image_url = new
                                {
                                    url = $"data:image/jpeg;base64,{base64Image}"
                                }
                            }
                        }
                    }
                },
                max_tokens = 1000,
                temperature = 0.7
            };

            var json = JsonSerializer.Serialize(requestBody);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            _httpClient.DefaultRequestHeaders.Clear();
            _httpClient.DefaultRequestHeaders.Add("Authorization", $"Bearer {apiKey}");

            var response = await _httpClient.PostAsync("https://api.openai.com/v1/chat/completions", content);
            response.EnsureSuccessStatusCode();

            var responseContent = await response.Content.ReadAsStringAsync();
            var responseJson = JsonDocument.Parse(responseContent);

            return responseJson.RootElement
                .GetProperty("choices")[0]
                .GetProperty("message")
                .GetProperty("content")
                .GetString() ?? "Analiz tamamlandı.";
        }


        private string BuildExercisePrompt(ExerciseRecommendationRequest request, ApplicationUser user)
        {
            var sb = new StringBuilder();
            sb.AppendLine("Sen bir fitness uzmanısın. Aşağıdaki bilgilere göre kişiselleştirilmiş bir egzersiz planı öner.");

            if (request.Height.HasValue && request.Weight.HasValue)
            {
                var bmi = request.Weight.Value / Math.Pow(request.Height.Value / 100.0, 2);
                sb.AppendLine($"Boy: {request.Height} cm, Kilo: {request.Weight} kg, BMI: {bmi:F2}");
            }

            if (!string.IsNullOrEmpty(request.BodyType))
            {
                sb.AppendLine($"Vücut Tipi: {request.BodyType}");
            }

            if (!string.IsNullOrEmpty(request.Goal))
            {
                sb.AppendLine($"Hedef: {request.Goal}");
            }

            if (!string.IsNullOrEmpty(request.FitnessLevel))
            {
                sb.AppendLine($"Fitness Seviyesi: {request.FitnessLevel}");
            }

            if (request.Age.HasValue)
            {
                sb.AppendLine($"Yaş: {request.Age}");
            }

            sb.AppendLine("\nLütfen haftalık bir egzersiz planı oluştur. Her gün için önerilen egzersizleri, set sayılarını ve tekrar sayılarını belirt.");

            return sb.ToString();
        }

        private string BuildDietPrompt(DietPlanRequest request, ApplicationUser user)
        {
            var sb = new StringBuilder();
            sb.AppendLine("Sen bir beslenme uzmanısın. Aşağıdaki bilgilere göre kişiselleştirilmiş bir diyet planı öner.");

            if (request.Height.HasValue && request.Weight.HasValue)
            {
                var bmi = request.Weight.Value / Math.Pow(request.Height.Value / 100.0, 2);
                sb.AppendLine($"Boy: {request.Height} cm, Kilo: {request.Weight} kg, BMI: {bmi:F2}");
            }

            if (!string.IsNullOrEmpty(request.Goal))
            {
                sb.AppendLine($"Hedef: {request.Goal}");
            }

            if (request.Age.HasValue)
            {
                sb.AppendLine($"Yaş: {request.Age}");
            }

            if (!string.IsNullOrEmpty(request.DietaryRestrictions))
            {
                sb.AppendLine($"Diyet Kısıtlamaları: {request.DietaryRestrictions}");
            }

            sb.AppendLine("\nLütfen günlük bir beslenme planı oluştur. Kahvaltı, öğle yemeği, akşam yemeği ve ara öğünler için öneriler sun.");

            return sb.ToString();
        }

        private async Task<string> CallOpenAI(string apiKey, string prompt)
        {
            var requestBody = new
            {
                model = "gpt-3.5-turbo",
                messages = new[]
                {
                    new { role = "system", content = "Sen bir fitness ve beslenme uzmanısın. Türkçe yanıt ver." },
                    new { role = "user", content = prompt }
                },
                max_tokens = 1000,
                temperature = 0.7
            };

            var json = JsonSerializer.Serialize(requestBody);
            var content = new StringContent(json, Encoding.UTF8, "application/json");

            _httpClient.DefaultRequestHeaders.Clear();
            _httpClient.DefaultRequestHeaders.Add("Authorization", $"Bearer {apiKey}");

            var response = await _httpClient.PostAsync("https://api.openai.com/v1/chat/completions", content);
            response.EnsureSuccessStatusCode();

            var responseContent = await response.Content.ReadAsStringAsync();
            var responseJson = JsonDocument.Parse(responseContent);

            return responseJson.RootElement
                .GetProperty("choices")[0]
                .GetProperty("message")
                .GetProperty("content")
                .GetString() ?? "Yanıt alınamadı.";
        }
    }

    public class ExerciseRecommendationRequest
    {
        public int? Height { get; set; }
        public int? Weight { get; set; }
        public string? BodyType { get; set; }
        public string? Goal { get; set; }
        public string? FitnessLevel { get; set; }
        public int? Age { get; set; }
    }

    public class DietPlanRequest
    {
        public int? Height { get; set; }
        public int? Weight { get; set; }
        public string? Goal { get; set; }
        public int? Age { get; set; }
        public string? DietaryRestrictions { get; set; }
    }

}


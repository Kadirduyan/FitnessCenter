@model IEnumerable<FitnessCenter.Models.Trainer>

@{
    ViewData["Title"] = "Antrenör Yönetimi";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">Antrenör Yönetimi</h1>
        <a asp-action="CreateTrainer" class="btn btn-success">
            <i class="bi bi-plus-circle me-2"></i>Yeni Antrenör Ekle
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>Ad Soyad</th>
                            <th>Uzmanlık Alanları</th>
                            <th>Spor Salonu</th>
                            <th>Hizmetler</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var trainer in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <img src="https://via.placeholder.com/40x40/007bff/ffffff?text=@(trainer.FirstName[0])@(trainer.LastName[0])"
                                             alt="@trainer.FirstName @trainer.LastName"
                                             class="rounded-circle me-3">
                                        <div>
                                            <strong>@trainer.FirstName @trainer.LastName</strong><br>
                                            <small class="text-muted">@trainer.Email</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-secondary">@trainer.Specializations</span>
                                </td>
                                <td>@trainer.FitnessCenter?.Name</td>
                                <td>
                                    @foreach (var service in trainer.Services)
                                    {
                                        <span class="badge bg-info me-1">@service.Name</span>
                                    }
                                </td>
                                <td>
                                    @if (trainer.IsActive)
                                    {
                                        <span class="badge bg-success">Aktif</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Pasif</span>
                                    }
                                </td>
                                <td>
                                    <div class="btn-group" role="group">
                                        <a asp-controller="Trainers" asp-action="Details" asp-route-id="@trainer.Id"
                                           class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye"></i> Görüntüle
                                        </a>
                                        <a asp-controller="Trainers" asp-action="Edit" asp-route-id="@trainer.Id"
                                           class="btn btn-sm btn-outline-warning">
                                            <i class="bi bi-pencil"></i> Düzenle
                                        </a>
                                        <form asp-action="DeleteTrainer" asp-route-id="@trainer.Id"
                                              method="post" class="d-inline"
                                              onsubmit="return confirm('Bu antrenörü silmek istediğinizden emin misiniz?');">
                                            <button type="submit" class="btn btn-sm btn-outline-danger">
                                                <i class="bi bi-trash"></i> Sil
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-people-fill text-muted" style="font-size: 3rem;"></i>
                    <h5 class="text-muted mt-3">Henüz antrenör eklenmemiş</h5>
                    <a asp-action="CreateTrainer" class="btn btn-primary mt-3">
                        İlk Antrenörü Ekle
                    </a>
                </div>
            }
        </div>
    </div>
</div>

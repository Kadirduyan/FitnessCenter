@model dynamic
@{
    ViewData["Title"] = "Ana Sayfa";
    var fitnessCenters = ViewBag.FitnessCenters as List<FitnessCenter.Models.FitnessCenterModel> ?? new List<FitnessCenter.Models.FitnessCenterModel>();
}

<!-- Hero Slider Section -->
<div id="heroCarousel" class="carousel slide carousel-fade" data-bs-ride="carousel" data-bs-interval="5000">
    <div class="carousel-indicators">
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="0" class="active"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="1"></button>
        <button type="button" data-bs-target="#heroCarousel" data-bs-slide-to="2"></button>
    </div>
    <div class="carousel-inner">
        <!-- Slide 1 -->
        <div class="carousel-item active">
            <div class="hero-slide" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=1920&q=80');">
                <div class="hero-content">
                    <div class="hero-text">
                        <h1 class="hero-title">FITNESS EVOLVED</h1>
                        <div class="hero-logo">FRED</div>
                        <h2 class="hero-subtitle">TRAINING REIMAGINED</h2>
                        <p class="hero-description">Türkiye'nin ilk tam ölçekli yapay zeka destekli spor salonu</p>
                        @if (!User.Identity?.IsAuthenticated == true)
                        {
                            <a asp-controller="Account" asp-action="Register" class="btn btn-warning btn-lg mt-4">Ücretsiz Değerlendirme</a>
                        }
                        else
                        {
                            <a asp-controller="Appointments" asp-action="Create" class="btn btn-warning btn-lg mt-4">Randevu Al</a>
                        }
                    </div>
                </div>
            </div>
        </div>
        <!-- Slide 2 -->
        <div class="carousel-item">
            <div class="hero-slide" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1571019613454-1cb2f99b84d4?w=1920&q=80');">
                <div class="hero-content">
                    <div class="hero-text">
                        <h1 class="hero-title">YAPAY ZEKA DESTEKLİ</h1>
                        <div class="hero-logo">FITNESS</div>
                        <h2 class="hero-subtitle">KİŞİSELLEŞTİRİLMİŞ DENEYİM</h2>
                        <p class="hero-description">Ekipmanlarınız size uyum sağlar. Tahmin yok, sadece ilerleme.</p>
                        <a href="#fitness" class="btn btn-warning btn-lg mt-4">Daha Fazla Bilgi</a>
                    </div>
                </div>
            </div>
        </div>
        <!-- Slide 3 -->
        <div class="carousel-item">
            <div class="hero-slide" style="background-image: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('https://images.unsplash.com/photo-1540497077202-7c8a3999166f?w=1920&q=80');">
                <div class="hero-content">
                    <div class="hero-text">
                        <h1 class="hero-title">BIOHACKING</h1>
                        <div class="hero-logo">SAĞLIK</div>
                        <h2 class="hero-subtitle">UZUN ÖMÜR İÇİN</h2>
                        <p class="hero-description">Sağlık ve uzun ömür konusundaki yeni buluşlarla biyolojik yaşınızı iyileştirin.</p>
                        <a href="#biohacking" class="btn btn-warning btn-lg mt-4">Keşfet</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <button class="carousel-control-prev" type="button" data-bs-target="#heroCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Önceki</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#heroCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon" aria-hidden="true"></span>
        <span class="visually-hidden">Sonraki</span>
    </button>
</div>

<!-- Fitness Section -->
<section id="fitness" class="section-fitness">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 mb-4 mb-lg-0">
                <h2 class="section-title-large">FITNESS</h2>
                <p class="section-description">
                    Yapay zeka destekli fitness ekipmanları ile performansınızı takip edin. 
                    Rehberli güç, kardiyo ve mobilite antrenmanları. Yapay zeka teknolojisini 
                    insan dokunuşu ile birleştirerek motivasyonunuzu ve ilerlemenizi sağlıyoruz.
                </p>
                <a href="#" class="btn btn-outline-dark btn-lg">Daha Fazla Bilgi</a>
            </div>
            <div class="col-lg-6">
                <div class="fitness-image-wrapper">
                    <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b84d4?w=800&q=80" 
                         alt="Fitness Equipment" class="img-fluid rounded">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Biohacking Section -->
<section id="biohacking" class="section-biohacking">
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-6 order-lg-2 mb-4 mb-lg-0">
                <h2 class="section-title-large">BIOHACKING</h2>
                <p class="section-description">
                    Mobiliteyi iyileştirerek biyolojik yaşınızı iyileştirin. Sağlık ve uzun ömür 
                    konusundaki yeni buluşlarla sizi güçlendiriyoruz. Biohacking'i kolaylaştırıyoruz.
                </p>
                <a href="#" class="btn btn-outline-dark btn-lg">Daha Fazla Bilgi</a>
            </div>
            <div class="col-lg-6 order-lg-1">
                <div class="biohacking-image-wrapper">
                    <img src="https://images.unsplash.com/photo-1540497077202-7c8a3999166f?w=800&q=80" 
                         alt="Biohacking" class="img-fluid rounded">
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Classes and Events Section -->
<section id="classes" class="section-classes">
    <div class="container">
        <h2 class="section-title text-center mb-5">Ne Var?</h2>
        <div class="row">
            <div class="col-md-4 mb-4">
                <div class="class-card">
                    <h3 class="class-title">Sınıflar</h3>
                    <p class="class-description">
                        Haftalık ücretsiz sınıflar:
                    </p>
                    <p class="class-details">
                        <strong>Mat Pilates</strong><br>
                        Pazartesi, Çarşamba, Cuma: 18:30<br>
                        Salı, Perşembe: 11:00
                    </p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="class-card">
                    <h3 class="class-title">Etkinlikler</h3>
                    <p class="class-description">
                        İyi bir parti, refahınız için gereklidir. Bir sonraki etkinliği yakında duyuracağız.
                    </p>
                    <p class="class-details">
                        Haberdar olmak için sayfanın altındaki bültenimize kaydolun.
                    </p>
                </div>
            </div>
            <div class="col-md-4 mb-4">
                <div class="class-card">
                    <h3 class="class-title">Haberler</h3>
                    <p class="class-description">
                        Yapay zeka destekli fitness teknolojilerimizle işbirliğimizi duyurmaktan gurur duyuyoruz.
                    </p>
                    <p class="class-details">
                        Daha fazla bilgi için Biohacking sayfasına bakın.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Membership Section -->
<section id="membership" class="section-membership">
    <div class="container">
        <div class="membership-card">
            <div class="row align-items-center">
                <div class="col-lg-6">
                    <h2 class="membership-title">FRED FITNESS Üyeliği</h2>
                    <div class="membership-badges">
                        <span class="badge">Aylık Üyelik</span>
                        <span class="badge">Ücret Yok</span>
                        <span class="badge">Ücretsiz Fitness Değerlendirmesi</span>
                    </div>
                    <div class="membership-price">
                        <span class="price-old">₺170</span>
                        <span class="price-new">₺150</span>
                        <span class="price-period">/ ay</span>
                    </div>
                    <ul class="membership-features">
                        <li><i class="bi bi-check-circle-fill"></i> Devrimci Teknoloji</li>
                        <li><i class="bi bi-check-circle-fill"></i> Yapay Zeka Destekli Antrenman Planları</li>
                        <li><i class="bi bi-check-circle-fill"></i> Güçlendirici Atmosfer</li>
                        <li><i class="bi bi-check-circle-fill"></i> Ücretsiz Sınıflar</li>
                        <li><i class="bi bi-check-circle-fill"></i> Etkinlikler</li>
                    </ul>
                    @if (!User.Identity?.IsAuthenticated == true)
                    {
                        <a asp-controller="Account" asp-action="Register" class="btn btn-warning btn-lg">Şimdi Katıl</a>
                    }
                </div>
                <div class="col-lg-6">
                    <div class="membership-image">
                        <img src="https://images.unsplash.com/photo-1534438327276-14e5300c3a48?w=800&q=80" 
                             alt="Membership" class="img-fluid rounded">
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        // Smooth scroll for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });
    </script>
}

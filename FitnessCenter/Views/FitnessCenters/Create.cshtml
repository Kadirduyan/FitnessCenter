@model FitnessCenter.Models.FitnessCenterModel
@{
    ViewData["Title"] = "Yeni Spor Salonu Ekle";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow border-0">
                <div class="card-header bg-white border-0 pt-4 pb-0">
                    <h2 class="text-center fw-bold text-primary">Yeni Spor Salonu Ekle</h2>
                    <p class="text-center text-muted">Sisteme yeni bir fitness merkezi tanımlayın</p>
                </div>
                
                <div class="card-body p-5">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold"><i class="bi bi-building"></i> Spor Salonu Adı</label>
                            <input asp-for="Name" class="form-control form-control-lg" placeholder="Örn: Kadir Fitness - Kadıköy Şubesi" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold"><i class="bi bi-file-text"></i> Açıklama</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="Salon hakkında kısa bilgi..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label fw-bold"><i class="bi bi-geo-alt"></i> Adres</label>
                            <input asp-for="Address" class="form-control" placeholder="Tam adres bilgisi" />
                            <span asp-validation-for="Address" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="Phone" class="form-label fw-bold"><i class="bi bi-telephone"></i> Telefon</label>
                                <input asp-for="Phone" class="form-control" placeholder="(555) 000-0000" />
                                <span asp-validation-for="Phone" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-4">
                                <label asp-for="Email" class="form-label fw-bold"><i class="bi bi-envelope"></i> E-posta</label>
                                <input asp-for="Email" class="form-control" type="email" placeholder="sube@fitness.com" />
                                <span asp-validation-for="Email" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-4">
                                <label asp-for="OpenTime" class="form-label fw-bold"><i class="bi bi-clock"></i> Açılış Saati</label>
                                <input asp-for="OpenTime" class="form-control" type="time" />
                                <span asp-validation-for="OpenTime" class="text-danger"></span>
                            </div>
                            <div class="col-md-6 mb-4">
                                <label asp-for="CloseTime" class="form-label fw-bold"><i class="bi bi-clock-fill"></i> Kapanış Saati</label>
                                <input asp-for="CloseTime" class="form-control" type="time" />
                                <span asp-validation-for="CloseTime" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">
                                <i class="bi bi-check-lg"></i> Kaydet
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
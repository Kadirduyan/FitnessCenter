@model FitnessCenter.Models.Service
@{
    ViewData["Title"] = "Yeni Hizmet Ekle";
}

<div class="container my-5">
    <h1>Yeni Hizmet Ekle</h1>
    <hr />

    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <div class="mb-3">
                    <label asp-for="Name" class="form-label"></label>
                    <input asp-for="Name" class="form-control" placeholder="Örn: Kişisel Antrenörlük" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="ServiceType" class="form-label"></label>
                    <select asp-for="ServiceType" class="form-select" asp-items="Html.GetEnumSelectList<FitnessCenter.Models.ServiceType>()">
                        <option value="">Hizmet türü seçiniz</option>
                    </select>
                    <span asp-validation-for="ServiceType" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label"></label>
                    <textarea asp-for="Description" class="form-control" rows="4" placeholder="Hizmet açıklaması"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="DurationMinutes" class="form-label"></label>
                        <input asp-for="DurationMinutes" class="form-control" type="number" min="1" max="480" placeholder="Örn: 60" />
                        <small class="form-text text-muted">Dakika cinsinden süre (1-480 arası)</small>
                        <span asp-validation-for="DurationMinutes" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Price" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Price" class="form-control" type="number" step="0.01" min="0" placeholder="Örn: 150.00" />
                            <span class="input-group-text">₺</span>
                        </div>
                        <span asp-validation-for="Price" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="FitnessCenterId" class="form-label"></label>
                    <select asp-for="FitnessCenterId" class="form-select" asp-items="ViewBag.FitnessCenterId">
                        <option value="">Spor salonu seçiniz</option>
                    </select>
                    <span asp-validation-for="FitnessCenterId" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-warning">Kaydet</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}


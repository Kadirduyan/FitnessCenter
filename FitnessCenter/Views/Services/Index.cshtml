@model IEnumerable<FitnessCenter.Models.Service>
@{
    ViewData["Title"] = "Hizmetler";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Hizmetler</h1>
        <a asp-action="Create" class="btn btn-warning">Yeni Hizmet Ekle</a>
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    <th>Hizmet Adı</th>
                    <th>Hizmet Türü</th>
                    <th>Süre (Dakika)</th>
                    <th>Ücret (TL)</th>
                    <th>Spor Salonu</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><strong>@item.Name</strong></td>
                        <td>
                            <span class="badge bg-info">@item.ServiceType</span>
                        </td>
                        <td>@item.DurationMinutes dk</td>
                        <td><strong>@item.Price.ToString("N2") ₺</strong></td>
                        <td>@item.FitnessCenter?.Name</td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detay</a>
                            <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                            <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Sil</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>


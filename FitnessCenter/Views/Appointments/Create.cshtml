@model FitnessCenter.Models.Trainer
@{
    ViewData["Title"] = "Yeni Antrenör Ekle";
    var services = ViewBag.Services as List<FitnessCenter.Models.Service>;
}

<div class="container my-5">
    <h1>Yeni Antrenör Ekle</h1>
    <hr />
    <div class="row">
        <div class="col-md-8">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FirstName" class="form-label"></label>
                        <input asp-for="FirstName" class="form-control" />
                        <span asp-validation-for="FirstName" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="LastName" class="form-label"></label>
                        <input asp-for="LastName" class="form-control" />
                        <span asp-validation-for="LastName" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="FitnessCenterId" class="form-label"></label>
                    <select asp-for="FitnessCenterId" class ="form-select" asp-items="ViewBag.FitnessCenterId"></select>
                </div>

                <div class="mb-3">
                    <label asp-for="Specializations" class="form-label"></label>
                    <input asp-for="Specializations" class="form-control" placeholder="Örn: Kilo Verme, Kas Geliştirme, Yoga" />
                    <span asp-validation-for="Specializations" class="text-danger"></span>
                    <small class="text-muted">Uzmanlık alanlarını virgülle ayırarak yazınız.</small>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-bold">Verebileceği Hizmetler</label>
                    <div class="card">
                        <div class="card-body">
                            <div class="row">
                                @if (services != null)
                                {
                                    foreach (var service in services)
                                    {
                                        <div class="col-md-6">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" name="selectedServices" value="@service.Id" id="service_@service.Id">
                                                <label class="form-check-label" for="service_@service.Id">
                                                    @service.Name (@service.ServiceType)
                                                </label>
                                            </div>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Email" class="form-label"></label>
                    <input asp-for="Email" class="form-control" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>

                <div class="mb-3 form-check">
                    <label class="form-check-label">
                        <input class="form-check-input" asp-for="IsActive" /> @Html.DisplayNameFor(model => model.IsActive)
                    </label>
                </div>

                <div class="mb-3">
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                    <a asp-action="Index" class="btn btn-secondary">İptal</a>
                </div>
            </form>
        </div>
    </div>
</div>
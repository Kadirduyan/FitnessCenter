@model IEnumerable<FitnessCenter.Models.Appointment>
@{
    ViewData["Title"] = "Randevularım";
}

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@(User.IsInRole("Admin") ? "Tüm Randevular" : "Randevularım")</h1>
        @if (!User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary">Yeni Randevu Al</a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped table-hover">
            <thead>
                <tr>
                    @if (User.IsInRole("Admin"))
                    {
                        <th>Üye</th>
                    }
                    <th>Antrenör</th>
                    <th>Hizmet</th>
                    <th>Tarih</th>
                    <th>Saat</th>
                    <th>Durum</th>
                    <th>İşlemler</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        @if (User.IsInRole("Admin"))
                        {
                            <td>@item.Member?.FirstName @item.Member?.LastName</td>
                        }
                        <td>@item.Trainer?.FullName</td>
                        <td>@item.Service?.Name</td>
                        <td>@item.AppointmentDate.ToString("dd.MM.yyyy")</td>
                        <td>@item.AppointmentTime.ToString(@"hh\:mm")</td>
                        <td>
                            @switch (item.Status)
                            {
                                case AppointmentStatus.Pending:
                                    <span class="badge bg-warning">Beklemede</span>
                                    break;
                                case AppointmentStatus.Approved:
                                    <span class="badge bg-success">Onaylandı</span>
                                    break;
                                case AppointmentStatus.Rejected:
                                    <span class="badge bg-danger">Reddedildi</span>
                                    break;
                                case AppointmentStatus.Completed:
                                    <span class="badge bg-info">Tamamlandı</span>
                                    break;
                                case AppointmentStatus.Cancelled:
                                    <span class="badge bg-secondary">İptal Edildi</span>
                                    break;
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Detay</a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Düzenle</a>
                            }
                            @if (item.Status == AppointmentStatus.Pending || item.Status == AppointmentStatus.Approved)
                            {
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">İptal Et</a>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

